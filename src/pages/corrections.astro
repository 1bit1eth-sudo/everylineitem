---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const corrections = await getEntry("pages", "corrections");

if (!corrections) {
  throw new Error(
    "Missing content entry: `corrections.md` or `corrections.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(corrections);
---

<Layout
  title={`${corrections.data.title} | ${config.site.title}`}
  description={corrections.data.description}
  ogImage={corrections.data.ogImage}
  canonicalURL={corrections.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={corrections.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
