---
import feesData from "@/data/fees.json";
import { jurisStack } from "@/lib/feeCalc";
import { csvExportDate, csvFileNames } from "@/lib/csvExport";
import { parseVerified, formatVerified } from "@/utils/formatVerified";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import FeeAlertSignup from "@/components/FeeAlertSignup.astro";
import LinkButton from "@/components/LinkButton.astro";
import NextReads from "@/components/NextReads.astro";
import { TOOLS } from "@/lib/related";

const title = "California ADU Fee Index — Q3 2026 | Every Line Item";
const jurisCount = (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE").length;
const description =
  `California ADU government fees, indexed: school-fee spread, heaviest verified fee stacks, and the biggest 750 sq ft cliffs across ${jurisCount} jurisdictions.`;

// --- computed facts (same math as the site calculator, 800 sq ft baseline) ---
const items = (feesData.fee_items as any[]).filter(
  i => i.status === "verified" && i.juris_id !== "LA-BASE"
);
const names = Object.fromEntries(
  (feesData.jurisdictions as any[]).map(j => [j.juris_id, j.name])
);

const schools = items
  .filter(i => i.category === "school" && i.method === "per_sqft")
  .sort((a, b) => a.rate_low - b.rate_low);
const atCeiling = schools.filter(s => s.rate_low === 5.38).length;
const maxSchool = schools[schools.length - 1];
const maxSchoolNote =
  maxSchool.rate_low > 5.38
    ? `in ${names[maxSchool.juris_id]}, where the district charges a Level II $${maxSchool.rate_low}/sq ft fee — above the $5.38 Level I cap`
    : `where districts charge the $5.38 Level I cap`;

const totals = new Map<string, number>();
const counts = new Map<string, number>();
const cliff = new Map<string, number>();
const schoolByJuris = new Map<string, number>();
for (const j of (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE")) {
  // Shared engine math: dwelling-base lines prorate at the 1,600 sq ft
  // default primary, and mutually exclusive area schedules (Ontario)
  // contribute their largest area only — never the sum of areas.
  const stack = jurisStack(feesData as any, j.juris_id, 800);
  totals.set(j.juris_id, stack.total);
  counts.set(j.juris_id, stack.count);
  cliff.set(j.juris_id, stack.cliff);
  if (stack.school != null) schoolByJuris.set(j.juris_id, stack.school);
}

// School-fee spread is computed per jurisdiction from jurisStack's
// school field — the jurisdiction's combined school fee (elementary +
// high school shares summed at 800 sq ft). Comparing single district
// rows is wrong: one row can be only one share of a split district
// (Campbell's high school share FI-295 $1.61/sq ft is $1,288 alone,
// but the parcel also pays the elementary share FI-294 $3.77/sq ft —
// $4,304 combined at the $5.38 Level I cap). Jurisdictions whose only verified school row is a
// partial (high school) share are excluded from the low end:
// - LOS-GATOS: FI-182 LGSUHSD high school share only ($1.66/sq ft)
// - SARATOGA: FI-248 LGSUHSD high school share only ($1.66/sq ft)
// - EL-CENTRO: EL-CENTRO-NEW-01 CUHSD high school share only ($1.66/sq ft)
// - ONTARIO: FI-319 Chaffey HSD 9-12 share only ($1.67/sq ft)
// - LOS-ALTOS: FI-223 MVLA HSD high school share only ($1.72/sq ft;
//   elementary share unverified)
const PARTIAL_SCHOOL_JURIS = new Set([
  "LOS-GATOS",
  "SARATOGA",
  "EL-CENTRO",
  "ONTARIO",
  "LOS-ALTOS",
]);
const schoolSpread = [...schoolByJuris.entries()]
  .filter(([j, v]) => v != null && !PARTIAL_SCHOOL_JURIS.has(j))
  .sort((a, b) => a[1] - b[1]);
const [minSchoolJuris, minSchool] = schoolSpread[0];
const [, maxSchoolTotal] = schoolSpread[schoolSpread.length - 1];
const ranked = [...totals.entries()]
  .filter(([j]) => (counts.get(j) ?? 0) >= 3)
  .sort((a, b) => b[1] - a[1]);
const [topJuris, topTotal] = ranked[0];
const [topCliffJuris, topCliff] = [...cliff.entries()].sort((a, b) => b[1] - a[1])[0];

// Content loop (stage 2): the index itself must lead somewhere. Ranked
// lists, all computed from the same maps above — no hand-written list.
// Each entry links to that jurisdiction's verified fee table.
const feeSlug = (j: string) => `/fees/${j.toLowerCase()}/`;
const topSchoolLow = schoolSpread.slice(0, 5);
const topSchoolHigh = [...schoolSpread].slice(-5).reverse();
const topStacks = ranked.slice(0, 5);
const topCliffs = [...cliff.entries()]
  .filter(([, v]) => v > 0)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

const fmt = (n: number) => "$" + Math.round(n).toLocaleString("en-US");

// One-line stats for copying — every jurisdiction's combined school fee
// on an 800 sq ft ADU, from verified line items only. Same jurisStack
// math as the spread above. Jurisdictions whose only verified school row
// is a partial (high school) share keep their line but are flagged, so a
// copied line never reads as a combined fee.
const schoolLines = [...schoolByJuris.entries()]
  .sort((a, b) => names[a[0]].localeCompare(names[b[0]]))
  .map(([j, v]) => {
    const line = `${names[j]}: ${fmt(v)} school fees (800 sq ft)`;
    return PARTIAL_SCHOOL_JURIS.has(j)
      ? `${line} — high school share only`
      : line;
  });
const schoolLinesText = schoolLines.join("\n");

// Public CSV filenames (generated at build time from the same verified
// data as this page — see src/lib/csvExport). The dated file and the
// latest file carry identical content; the Q3 URL is kept as a legacy
// alias serving the same file.
const csvDate = csvExportDate();
const csvNames = csvFileNames(csvDate);
const jurisWithVerified = new Set(
  items.map(i => i.juris_id as string)
).size;

// Citation for the CSV dataset, reused by the visible text and the copy
// button (via data-citation) so the two can never drift apart.
const citation =
  "Source: Every Line Item — California ADU Fee Index, Q3 2026. everylineitem.com/fee-index/";

// Trust line — newest verification date across the verified line items
// behind this index. Verified-only: to_verify items contribute no figure
// here, so their dates must not set the index's "last verified" date.
const latestVerifiedRaw = items
  .map(i => i.last_verified as string)
  .filter(Boolean)
  .sort((a, b) => parseVerified(b) - parseVerified(a))[0];
const latestVerified = formatVerified(latestVerifiedRaw);

const facts = [
  {
    stat: `${fmt(minSchool)} → ${fmt(maxSchoolTotal)}`,
    label: "School-fee spread",
    desc: `The same 800 sq ft ADU pays ${fmt(minSchool)} in school fees in ${names[minSchoolJuris]} and ${fmt(maxSchoolTotal)} ${maxSchoolNote}. Each figure is one jurisdiction's combined school fee — elementary and high school shares summed — and the low end leaves out jurisdictions where only one share is verified.`,
  },
  {
    stat: `${atCeiling} of ${schools.length}`,
    label: "Districts at the ceiling",
    desc: `School districts charging the $5.38/sq ft Level I cap — ${Math.round((atCeiling / schools.length) * 100)}% of the districts we've verified. ${atCeiling} districts now charge the cap, up from 21 at the Q3 launch.`,
  },
  {
    stat: fmt(topTotal),
    label: "Heaviest verified stack",
    desc: `${names[topJuris]}: ${fmt(topTotal)} in verified government fees on an 800 sq ft ADU (${counts.get(topJuris)} line items). This is the confirmed floor — the real total only goes up.`,
  },
  {
    stat: fmt(topCliff),
    label: "Biggest 750 sq ft cliff",
    desc: `${names[topCliffJuris]}: ${fmt(topCliff)} in impact fees that exist at 751 sq ft and vanish at 750 sq ft by state law. One square foot, ${fmt(topCliff)}.`,
  },
  {
    stat: `${(feesData.jurisdictions as any[]).length - 1} × ${items.length}`,
    label: "Coverage",
    desc: "Jurisdictions tracked and verified line items behind this index. Every figure links to the official source document it came from — no estimates.",
  },
];
---

<Layout title={title} description={description}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-8">
    <p class="text-sm font-mono uppercase tracking-wide opacity-60">
      Q3 2026 &middot; data edition
    </p>
    <h1 class="my-4 text-3xl font-bold sm:text-4xl">
      California ADU Fee Index
    </h1>
    <p class="text-lg opacity-80 max-w-3xl">
      The first public index of what California governments actually charge
      for ADUs. Five facts from {items.length} verified line items across{" "}
      {(feesData.jurisdictions as any[]).length - 1} jurisdictions — each one
      traceable to the source document. Q4 edition follows the December
      re-verification.
    </p>
    <p class="mt-3 text-sm opacity-70">
      Figures last verified against official sources on {latestVerified} — the
      most recent check across the {items.length} verified line items behind
      this index.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {facts.map(f => (
        <div class="border border-border rounded-lg p-5">
          <p class="text-3xl font-bold tabular-nums text-accent">{f.stat}</p>
          <p class="mt-2 font-semibold">{f.label}</p>
          <p class="mt-1 text-sm opacity-70">{f.desc}</p>
        </div>
      ))}
      <div class="border border-border rounded-lg p-5 flex flex-col justify-between">
        <div>
          <p class="font-semibold">The full dataset</p>
          <p class="mt-1 text-sm opacity-70">
            Every verified line item: jurisdiction, fee, rate, and the 800
            sq ft amount, with the official source and check date. Free CSV,
            no email needed. Generated {csvDate} from the same verified data
            as this page — {items.length} verified line items across{" "}
            {jurisWithVerified} jurisdictions.
          </p>
        </div>
        <p class="mt-3">
          <LinkButton
            class="text-accent font-semibold underline decoration-dashed underline-offset-4"
            href={`/downloads/${csvNames.latest}`}
          >
            Download the index CSV &rarr;
          </LinkButton>
        </p>
        <p class="mt-2 text-sm opacity-70">
          Dated snapshot:{" "}
          <a
            href={`/downloads/${csvNames.dated}`}
            class="text-accent underline decoration-dashed underline-offset-4"
          >
            {csvNames.dated}
          </a>
        </p>
        <p class="mt-4 text-sm opacity-70">
          Cite as: {citation}
        </p>
        <p class="mt-1 text-sm opacity-70">
          Licensed under{" "}
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noopener"
            class="text-accent underline decoration-dashed underline-offset-4"
          >
            CC BY 4.0
          </a>{" "}
          — free to reuse with attribution.
        </p>
        <p class="mt-2">
          <button
            type="button"
            id="copy-citation"
            data-citation={citation}
            class="text-sm text-accent font-semibold underline decoration-dashed underline-offset-4"
          >
            Copy citation
          </button>
        </p>
      </div>
    </div>

    <h2 class="mt-12 text-2xl font-semibold">Rankings — 800 sq ft ADU</h2>
    <p class="mt-2 max-w-3xl text-sm opacity-70">
      Top five in each list, from the same verified line items as the facts
      above. Open a fee table to see the line items behind the figure.
    </p>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <section>
        <h3 class="font-semibold">Lowest school fees</h3>
        <ol class="mt-2 space-y-1.5">
          {topSchoolLow.map(([j, v]) => (
            <li class="flex justify-between gap-3">
              <a href={feeSlug(j)} class="text-accent underline decoration-dashed underline-offset-4">{names[j]}</a>
              <span class="tabular-nums font-semibold">{fmt(v)}</span>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h3 class="font-semibold">Highest school fees</h3>
        <ol class="mt-2 space-y-1.5">
          {topSchoolHigh.map(([j, v]) => (
            <li class="flex justify-between gap-3">
              <a href={feeSlug(j)} class="text-accent underline decoration-dashed underline-offset-4">{names[j]}</a>
              <span class="tabular-nums font-semibold">{fmt(v)}</span>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h3 class="font-semibold">Heaviest verified stacks</h3>
        <ol class="mt-2 space-y-1.5">
          {topStacks.map(([j, v]) => (
            <li class="flex justify-between gap-3">
              <a href={feeSlug(j)} class="text-accent underline decoration-dashed underline-offset-4">{names[j]}</a>
              <span class="tabular-nums font-semibold">{fmt(v)}</span>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h3 class="font-semibold">Biggest 750 sq ft cliffs</h3>
        <ol class="mt-2 space-y-1.5">
          {topCliffs.map(([j, v]) => (
            <li class="flex justify-between gap-3">
              <a href={feeSlug(j)} class="text-accent underline decoration-dashed underline-offset-4">{names[j]}</a>
              <span class="tabular-nums font-semibold">{fmt(v)}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <h2 class="mt-12 text-2xl font-semibold">How to read this</h2>
    <div class="mt-4 max-w-3xl space-y-3 opacity-80">
      <p>
        <strong class="font-semibold">Verified means read.</strong> A line item
        enters this index only after a researcher has read the official source
        — the city fee schedule, the school district's developer-fee
        resolution, the utility's charges. Figures marked partial or
        unconfirmed stay out.
      </p>
      <p>
        <strong class="font-semibold">Totals are floors, not ceilings.</strong>{" "}
        Jurisdictions have different numbers of verified items, so a lower
        total can mean less verification, not lower fees. The per-line figures
        are the solid ground; treat totals as confirmed minimums.
      </p>
      <p>
        <strong class="font-semibold">The cliff is state law.</strong> Gov.
        Code &sect;66311.5 bars impact fees on ADUs of 750 sq ft or less. The
        "at 751 sq ft" column shows what the verified impact fees total one
        square foot above the line.
      </p>
      <p>
        <strong class="font-semibold">Some fees are prorated, not flat.</strong>{" "}
        A few cities publish a per-dwelling fee, not an ADU fee — the ADU pays
        (ADU sq ft ÷ primary-dwelling sq ft) of it. For those lines this
        index assumes a 1,600 sq ft primary dwelling and says so; the
        calculator lets you enter your actual primary size. Ontario has two
        mutually exclusive area schedules (General City, Ontario Ranch) — a
        parcel pays one, so this index uses the larger area's total, never
        their sum. See the{" "}
        <a href="/changes/" class="text-accent underline decoration-dashed underline-offset-4">change log</a>{" "}
        for the October 2026 correction that fixed the old summed figure.
      </p>
    </div>

    <h2 class="mt-12 text-2xl font-semibold">One-line stats, ready to copy</h2>
    <p class="mt-2 max-w-3xl text-sm opacity-70">
      Every jurisdiction's combined school fee on an 800 sq ft ADU, from
      verified line items only — elementary and high school shares summed.
      Jurisdictions where only the high school share is verified are flagged
      on their line. Copy one line or copy them all; if you republish them,
      please cite the index — the citation is next to the CSV download above.
    </p>
    <p class="mt-3">
      <button
        type="button"
        id="copy-school-lines"
        class="border border-border px-4 py-2 rounded font-medium text-sm"
      >
        Copy all {schoolLines.length} lines
      </button>
    </p>
    <details class="mt-4">
      <summary class="cursor-pointer text-sm font-semibold">
        Show all {schoolLines.length} jurisdictions
      </summary>
      <pre
        id="school-lines"
        class="mt-3 overflow-x-auto rounded-lg border border-border p-4 text-sm leading-relaxed"
      >{schoolLinesText}</pre>
    </details>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold">Get the Q4 edition</h2>
        <p class="mt-2 text-sm opacity-70">
          December re-verification will move these numbers. One email when the
          new index lands — nothing else.
        </p>
      </div>
      <div class="self-start">
        <FeeAlertSignup
          idPrefix="index-alert"
          heading="Notify me of the Q4 index"
          subtext="One email when the December re-verification publishes. No newsletter, unsubscribe anytime."
          buttonLabel="Notify me"
        />
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <LinkButton
        href="/fees/"
        class="border border-border px-5 py-3 rounded font-medium"
      >
        Browse all jurisdictions &rarr;
      </LinkButton>
      <LinkButton
        href="/changes/"
        class="underline decoration-dashed underline-offset-4"
      >
        Fee change log &rarr;
      </LinkButton>
    </div>

    <NextReads
      links={[
        { href: "/sb-1117/", label: "SB 1117 savings by city" },
        { href: "/methodology/", label: "How we verify" },
      ]}
      cta={TOOLS.compare}
    />
  </main>
  <Footer />
</Layout>

<script is:inline src="/scripts/copy-helpers.js"></script>
