---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const disclaimer = await getEntry("pages", "disclaimer");

if (!disclaimer) {
  throw new Error(
    "Missing content entry: `disclaimer.md` or `disclaimer.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(disclaimer);
---

<Layout
  title={`${disclaimer.data.title} | ${config.site.title}`}
  description={disclaimer.data.description}
  ogImage={disclaimer.data.ogImage}
  canonicalURL={disclaimer.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={disclaimer.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
