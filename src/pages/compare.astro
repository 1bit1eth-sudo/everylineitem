---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import EmailSignup from "@/components/EmailSignup.astro";
import FeeCalculator from "@/components/FeeCalculator.astro";
import {
  ADU_SCENARIOS,
  BENCHMARK_SOURCES,
  DEFAULT_COMPARE,
  PHASES,
  type AduScenario,
} from "@/data/aduScenarios";

const title = "Compare ADU costs | Every Line Item";
const description =
  "Pick two California ADU cost scenarios and compare them on the same six-phase ledger — totals, $/sq ft, and phase-by-phase diffs.";
const ogImage =
  "https://everylineitem.com/images/pinterest/400-vs-800-adu-cost.png";

const comparePayload = {
  scenarios: ADU_SCENARIOS,
  phases: PHASES,
  defaults: DEFAULT_COMPARE,
  sources: BENCHMARK_SOURCES,
};

// Server-rendered default view (same markup the client script produces), so
// the summary, table, notes and links are not empty without JavaScript.
const byId = new Map(ADU_SCENARIOS.map(s => [s.id, s]));
const ssrA = byId.get(DEFAULT_COMPARE.a)!;
const ssrB = byId.get(DEFAULT_COMPARE.b)!;

const fmtUsd = (n: number) =>
  Math.abs(n).toLocaleString("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  });
const money = (n: number) => (n < 0 ? "−" : "") + fmtUsd(n);
const moneyDiff = (n: number) =>
  n === 0 ? "$0" : (n > 0 ? "+" : "−") + fmtUsd(n);
const diffClass = (n: number) =>
  n > 0 ? "text-accent" : n < 0 ? "text-green-600 dark:text-green-400" : "";

const largestPhase = (sc: AduScenario) => {
  let best = { label: PHASES[0]?.label ?? "—", amount: 0 };
  for (const p of PHASES) {
    const amount = sc.phases[p.id] || 0;
    if (amount > best.amount) best = { label: p.label, amount };
  }
  for (const e of sc.extraPhases ?? []) {
    if (e.amount > best.amount) best = { label: e.label, amount: e.amount };
  }
  return best;
};

const ssrRows = PHASES.map(p => {
  const av = ssrA.phases[p.id] || 0;
  const bv = ssrB.phases[p.id] || 0;
  return { label: p.label, av, bv, diff: bv - av };
});
const ssrTotalDiff = ssrB.total - ssrA.total;
const ssrPsfDiff = ssrB.costPerSqFt - ssrA.costPerSqFt;
const ssrPsfText =
  ssrPsfDiff === 0
    ? "$0"
    : (ssrPsfDiff > 0 ? "+" : "−") +
      "$" +
      Math.abs(ssrPsfDiff).toLocaleString("en-US");
const ssrCards = [
  { tag: "Build A", sc: ssrA, largest: largestPhase(ssrA) },
  { tag: "Build B", sc: ssrB, largest: largestPhase(ssrB) },
];
const ssrNotes = [ssrA.note, ssrB.note].filter(Boolean).join(" ");
const qcDefault = ssrA;
const extraRows = [
  ...new Map(
    ADU_SCENARIOS.flatMap(sc => sc.extraPhases ?? []).map(e => [e.id, e])
  ).values(),
];
const linkClass =
  "text-accent underline decoration-dashed underline-offset-4";
const inputClass =
  "border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-2 py-1 text-sm font-normal tabular-nums focus:ring-1 focus:outline-none";
---

<Layout title={title} description={description} ogImage={ogImage}>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-8" data-backUrl="/compare/">
    <h1 class="text-2xl font-semibold sm:text-3xl">Compare ADU costs</h1>
    <p class="mt-2 mb-6 italic">
      Side-by-side on the same six-phase ledger. Figures match the published
      posts — pick any two builds.
    </p>

    <FeeCalculator />

    <div
      id="adu-compare"
      class="border-border bg-background space-y-6 rounded-lg border p-4 sm:p-6"
      data-defaults-a={DEFAULT_COMPARE.a}
      data-defaults-b={DEFAULT_COMPARE.b}
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-2 text-sm font-medium">
          <span>Build A</span>
          <select
            id="compare-a"
            class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none"
          >
            {
              ADU_SCENARIOS.map(s => (
                <option value={s.id} selected={s.id === DEFAULT_COMPARE.a}>
                  {s.label} — ${s.total.toLocaleString("en-US")}
                </option>
              ))
            }
          </select>
        </label>
        <label class="flex flex-col gap-2 text-sm font-medium">
          <span>Build B</span>
          <select
            id="compare-b"
            class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none"
          >
            {
              ADU_SCENARIOS.map(s => (
                <option value={s.id} selected={s.id === DEFAULT_COMPARE.b}>
                  {s.label} — ${s.total.toLocaleString("en-US")}
                </option>
              ))
            }
          </select>
        </label>
      </div>

      <div
        id="compare-summary"
        class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          ssrCards.map(({ tag, sc, largest }) => (
            <div class="border-border rounded-md border p-4">
              <div class="text-foreground/70 text-xs tracking-wide uppercase">
                {tag} · {sc.shortLabel}
              </div>
              <div class="mt-1 text-2xl font-semibold tabular-nums">
                {money(sc.total)}
              </div>
              <div class="mt-1 text-sm">
                ${sc.costPerSqFt.toLocaleString("en-US")}/sq ft ·{" "}
                {sc.sqFt.toLocaleString("en-US")} sq ft
              </div>
              <div class="text-foreground/80 mt-2 text-sm">
                Largest phase: {largest.label} ({money(largest.amount)})
              </div>
              <div class="text-foreground/60 mt-2 text-xs">
                Modeled median · checked {sc.lastVerified}
              </div>
            </div>
          ))
        }
        <div class="border-border border-accent/40 rounded-md border p-4 sm:col-span-2 lg:col-span-1">
          <div class="text-foreground/70 text-xs tracking-wide uppercase">
            Difference (B − A)
          </div>
          <div
            class:list={[
              "mt-1 text-2xl font-semibold tabular-nums",
              diffClass(ssrTotalDiff),
            ]}
          >
            {moneyDiff(ssrTotalDiff)}
          </div>
          <div class="mt-1 text-sm">{ssrPsfText}/sq ft</div>
        </div>
      </div>

      <div class="relative w-full overflow-x-auto">
        <table
          id="compare-table"
          class="w-full min-w-[36rem] border-collapse text-sm sm:text-base"
        >
          <thead>
            <tr class="border-border border-b text-left">
              <th class="py-2 pe-3 font-semibold">Phase</th>
              <th class="py-2 pe-3 font-semibold" id="col-a-label">
                {ssrA.shortLabel}
              </th>
              <th class="py-2 pe-3 font-semibold" id="col-b-label">
                {ssrB.shortLabel}
              </th>
              <th class="py-2 font-semibold">Diff</th>
            </tr>
          </thead>
          <tbody id="compare-tbody">
            {
              ssrRows.map(r => (
                <tr class="border-border border-b">
                  <td class="py-2 pe-3">{r.label}</td>
                  <td class="py-2 pe-3 tabular-nums">{money(r.av)}</td>
                  <td class="py-2 pe-3 tabular-nums">{money(r.bv)}</td>
                  <td class:list={["py-2 tabular-nums", diffClass(r.diff)]}>
                    {moneyDiff(r.diff)}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot id="compare-tfoot">
            <tr class="border-border border-t-2 font-semibold">
              <td class="py-3 pe-3">Total</td>
              <td class="py-3 pe-3 tabular-nums">{money(ssrA.total)}</td>
              <td class="py-3 pe-3 tabular-nums">{money(ssrB.total)}</td>
              <td class:list={["py-3 tabular-nums", diffClass(ssrTotalDiff)]}>
                {moneyDiff(ssrTotalDiff)}
              </td>
            </tr>
            <tr class="text-foreground/90">
              <td class="py-2 pe-3">$/sq ft</td>
              <td class="py-2 pe-3 tabular-nums">
                ${ssrA.costPerSqFt.toLocaleString("en-US")}
              </td>
              <td class="py-2 pe-3 tabular-nums">
                ${ssrB.costPerSqFt.toLocaleString("en-US")}
              </td>
              <td class="py-2 tabular-nums">{ssrPsfText}</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-foreground/80 text-sm">
        Half the size. Two-thirds the cost. Fixed costs — permits, the sewer
        connection, the kitchen, the bathroom — do not scale with floor area.
      </p>

      <p class="text-foreground/80 text-sm">
        Soft-cost gaps also hide a legal cliff: many California impact fees
        change at 750 sq ft (see
        <a
          href="/methodology/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >Methodology</a
        >
        / Gov. Code §66311.5). Check whether a quote’s fee line jumps when size
        crosses that threshold.
      </p>

      <p id="compare-notes" class="text-foreground/80 text-sm">{ssrNotes}</p>

      <div
        id="compare-links"
        class="border-border flex flex-col gap-2 border-t pt-4 text-sm sm:flex-row sm:gap-6"
      >
        <a class={linkClass} href={ssrA.href}>
          Full post: {ssrA.shortLabel} →
        </a>
        <a class={linkClass} href={ssrB.href}>
          Full post: {ssrB.shortLabel} →
        </a>
      </div>
    </div>

    <section
      id="quote-check"
      class="border-border bg-background mt-8 space-y-5 rounded-lg border p-4 sm:p-6"
      aria-labelledby="quote-check-title"
    >
      <div>
        <h2 id="quote-check-title" class="text-xl font-semibold">
          Check my quotes
        </h2>
        <p class="text-foreground/80 mt-2 text-sm">
          Type what each contractor quoted for each stage and how it is listed.
          You get the gap against a published benchmark, the stages that are
          missing, and questions to ask before you sign.
        </p>
        <p class="mt-2 text-sm font-medium">
          Runs only in your browser. Nothing you type is saved or sent anywhere.
        </p>
      </div>

      <label class="flex max-w-xl flex-col gap-2 text-sm font-medium">
        <span>Compare against this benchmark</span>
        <select
          id="qc-benchmark"
          class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none"
        >
          {
            ADU_SCENARIOS.map(sc => (
              <option value={sc.id} selected={sc.id === qcDefault.id}>
                {sc.label} — {money(sc.total)}
              </option>
            ))
          }
        </select>
      </label>

      <p id="qc-source" class="text-foreground/70 text-xs">
        Benchmark: <a class={linkClass} href={qcDefault.href}
          >{qcDefault.shortLabel}</a
        >, modeled median, checked {qcDefault.lastVerified}. Built from{" "}
        {
          BENCHMARK_SOURCES.map((src, i) => (
            <>
              <a class={linkClass} href={src.href} rel="noopener">
                {src.label}
              </a>
              {i < BENCHMARK_SOURCES.length - 1 ? ", " : ""}
            </>
          ))
        }
        . Not a quote. See <a class={linkClass} href="/methodology/"
          >Methodology</a
        >.
      </p>

      <div class="relative w-full overflow-x-auto">
        <table class="w-full min-w-[44rem] border-collapse text-sm">
          <thead>
            <tr class="border-border border-b text-left">
              <th class="py-2 pe-3 font-semibold">Stage</th>
              <th class="py-2 pe-3 font-semibold">Benchmark</th>
              <th class="py-2 pe-3 font-semibold">Quote A</th>
              <th class="py-2 pe-3 font-semibold">Quote B</th>
            </tr>
          </thead>
          <tbody id="qc-tbody">
            {
              [
                ...PHASES.map(p => ({
                  id: p.id,
                  label: p.label,
                  extra: false,
                  amount: qcDefault.phases[p.id] || 0,
                })),
                ...extraRows.map(e => ({
                  id: e.id,
                  label: e.label,
                  extra: true,
                  amount:
                    qcDefault.extraPhases?.find(x => x.id === e.id)?.amount ??
                    0,
                })),
              ].map(row => (
                <tr
                  class:list={[
                    "border-border border-b align-top",
                    {
                      hidden:
                        row.extra &&
                        !qcDefault.extraPhases?.some(x => x.id === row.id),
                    },
                  ]}
                  data-stage={row.id}
                  data-extra={row.extra ? "1" : undefined}
                >
                  <td class="py-2 pe-3">{row.label}</td>
                  <td class="py-2 pe-3 tabular-nums" data-bench>
                    {money(row.amount)}
                  </td>
                  {["a", "b"].map(q => (
                    <td class="py-2 pe-3">
                      <div class="flex flex-col gap-1">
                        <input
                          type="text"
                          inputmode="numeric"
                          autocomplete="off"
                          placeholder="$"
                          aria-label={`Quote ${q.toUpperCase()}: ${row.label} amount`}
                          class={inputClass}
                          data-q={q}
                          data-field="amount"
                        />
                        <select
                          aria-label={`Quote ${q.toUpperCase()}: ${row.label} status`}
                          class={inputClass}
                          data-q={q}
                          data-field="status"
                        >
                          <option value="notlisted" selected>Not listed</option>
                          <option value="included">Included</option>
                          <option value="allowance">Allowance</option>
                          <option value="excluded">Excluded</option>
                        </select>
                        <span
                          class="text-xs tabular-nums"
                          data-q={q}
                          data-field="diff"
                        ></span>
                      </div>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-border border-t-2 font-semibold">
              <td class="py-3 pe-3">Total</td>
              <td class="py-3 pe-3 tabular-nums" id="qc-bench-total">
                {money(qcDefault.total)}
              </td>
              <td class="py-3 pe-3 tabular-nums" id="qc-total-a">—</td>
              <td class="py-3 pe-3 tabular-nums" id="qc-total-b">—</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div id="qc-results" class="space-y-4" aria-live="polite">
        <p class="text-foreground/70 text-sm">
          Enter at least one amount to see flags and questions.
          <noscript>This checker needs JavaScript; the benchmark table above works without it.</noscript>
        </p>
      </div>
    </section>

    <EmailSignup idPrefix="compare-signup" class="mt-8" />

    <aside class="border-border bg-background mt-8 rounded-lg border p-4 sm:p-6">
      <h2 class="text-lg font-semibold">Verify two contractor quotes</h2>
      <p class="text-foreground/80 mt-2 text-sm">
        Download the blank six-phase
        <a
          href="/worksheet/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >worksheet</a
        >, map each bid onto the same rows, then compare published scenarios on
        this ledger. Source notes:
        <a
          href="/methodology/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >Methodology</a
        >.
      </p>
      <p class="text-foreground/80 mt-3 text-sm">
        Building in Los Angeles County? Start from the
        <a
          href="/posts/los-angeles-county-adu-cost/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >LA County ADU cost hub</a
        >
        (City of LA vs unincorporated paths on the same ledger), then bring your
        quote numbers back here.
      </p>
    </aside>

    <p class="text-foreground/80 mt-8 text-sm">
      Soft-costs-only is not a full build, so it is not a compare column.
      Download the blank ledger on the
      <a
        href="/worksheet/"
        class="text-accent underline decoration-dashed underline-offset-4"
        >worksheet</a
      >
      page, or read
      <a
        href="/about/"
        class="text-accent underline decoration-dashed underline-offset-4"
        >why the six phases exist</a
      >.
    </p>
  </main>

  <Footer />
</Layout>

<script
  id="adu-compare-data"
  type="application/json"
  is:inline
  set:html={JSON.stringify(comparePayload)}
/>

<script is:inline src="/scripts/adu-compare.js"></script>
<script is:inline src="/scripts/quote-check.js"></script>
