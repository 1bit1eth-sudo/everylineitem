---
import { postFilter } from "@/utils/postFilter";
import { getCollection } from "astro:content";
import feesData from "@/data/fees.json";
import {
  calcJurisdiction,
  jurisAreas,
  categoryLabel,
  fmtUSD,
} from "@/lib/feeCalc";
import { formatVerified } from "@/utils/formatVerified";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import LinkButton from "@/components/LinkButton.astro";
import NextReads from "@/components/NextReads.astro";
import PrevNext from "@/components/PrevNext.astro";
import { feeHubOrder } from "@/lib/hubOrder";
import { TOOLS } from "@/lib/related";

export async function getStaticPaths() {
  return feesData.jurisdictions
    .filter(j => j.juris_id !== "LA-BASE") // synthetic series baseline, not a real jurisdiction
    .map(j => ({
      params: { slug: j.juris_id.toLowerCase() },
      props: { juris: j },
    }));
}

const { juris } = Astro.props;
const SQFT = 800;

const posts = (await getCollection("posts")).filter(postFilter);
const postIds = new Set(posts.map(p => p.id));
const postSlug = juris.post_slug && postIds.has(juris.post_slug) ? juris.post_slug : null;

// Content loop (devices A + E): prev/next in hub order, and a next-read
// block. Same-topic link = another fee page in the same county (else the
// same region, else a hub neighbour) — all from fees.json, no fixed list.
const hubOrder = feeHubOrder(feesData as any);
const hubIdx = hubOrder.findIndex(j => j.juris_id === juris.juris_id);
const prevJuris = hubIdx > 0 ? hubOrder[hubIdx - 1] : null;
const nextJuris =
  hubIdx >= 0 && hubIdx < hubOrder.length - 1 ? hubOrder[hubIdx + 1] : null;
const siblingJuris =
  hubOrder.find(
    j => j.juris_id !== juris.juris_id && j.county === juris.county
  ) ??
  hubOrder.find(
    j => j.juris_id !== juris.juris_id && j.region === juris.region
  ) ??
  prevJuris ??
  nextJuris;

const result = calcJurisdiction(feesData as any, juris.juris_id, SQFT);

// Jurisdictions with mutually exclusive area schedules (Ontario, Carlsbad,
// Moreno Valley, Vacaville — and Marin County / Clovis once their area rows
// merge): a parcel pays ONE area's rows, never the sum. Compute each area
// present the total as a range; shared rows (school, permit) are deduped.
const areas = jurisAreas(feesData as any, juris.juris_id);
const isAreaJuris = areas.length > 0;
const areaResults = isAreaJuris
  ? areas.map(a => ({
      area: a,
      result: calcJurisdiction(feesData as any, juris.juris_id, SQFT, { area: a }),
    }))
  : [{ area: null as string | null, result }];

const dedupeLines = (pick: (l: any) => boolean) => {
  const byId = new Map<string, any>();
  for (const { result: r } of areaResults) {
    for (const l of r.lines.filter(pick)) {
      if (!byId.has(l.item.item_id)) byId.set(l.item.item_id, l);
    }
  }
  return [...byId.values()];
};
const verifiedLines = dedupeLines(
  l => l.item.status === "verified" && l.kind !== "skipped"
);
const pendingLines = dedupeLines(
  l => (l.item.status === "to_verify" || l.item.status === "conflict") && l.kind !== "skipped"
);
// Verified rates feeCalc skips because the jurisdiction has no valuation
// basis on file (pct_valuation / valuation_step rows, e.g. Diamond Bar's 8
// verified permit lines, Marin's surcharges). The rate itself is verified,
// only the dollar amount is uncomputable — show the rate, not a total.
const skippedVerifiedLines = dedupeLines(
  l => l.item.status === "verified" && l.kind === "skipped"
);
const skippedPendingLines = dedupeLines(
  l => (l.item.status === "to_verify" || l.item.status === "conflict") && l.kind === "skipped"
);

const areaTotals = areaResults.map(({ area, result: r }) => {
  const vl = r.lines.filter(l => l.item.status === "verified" && l.kind !== "skipped");
  return {
    area,
    low: vl.reduce((s, l) => s + l.low, 0),
    high: vl.reduce((s, l) => s + (l.high ?? l.low), 0),
    hasRange: vl.some(l => l.high != null),
  };
});
// 작업 3 (2026-11-14, AdSense "가치가 별로 없는 콘텐츠" 거절 대응): verified
// 행이 2건 미만인 /fees/ 페이지는 noindex. fees.json 원본 기준으로 세므로
// 800 sq ft 적용 여부와 무관하다. 2026-11-01의 "행 0건" 조건을 포함한다
// (0건이면 2건 미만이므로). 보강으로 2건이 되면 조건이 저절로 해제된다.
// 손으로 관리하는 목록은 없다. 기준 38831aa에서 35곳(LA-BASE 포함, 실제
// 페이지 34곳)이 이 조건에 걸린다.
const verifiedRowCount = (feesData as any).fee_items.filter(
  (i: { juris_id: string; status: string }) =>
    i.juris_id === juris.juris_id && i.status === "verified"
).length;
const thinFeePage = verifiedRowCount < 2;
const verifiedTotalLow = isAreaJuris
  ? Math.min(...areaTotals.map(t => t.low))
  : areaTotals[0].low;
const verifiedTotalHigh = isAreaJuris
  ? Math.max(...areaTotals.map(t => t.high))
  : areaTotals[0].high;
const verifiedHasRange = isAreaJuris || areaTotals[0].hasRange;

// The 750 sq ft cliff: impact fees at 751 sq ft vs $0 at 750 (state law).
// For area jurisdictions the cliff is a range across areas.
// Verified-only (2026-11-05): the cliff box and the FAQ both describe this
// total as "the impact fees we have verified", so to_verify rows must not
// enter it. Without this, a page with zero verified rows still showed a
// dollar total (Clovis: $57,445 from 14 unconfirmed rows). With it, the
// total is $0 when nothing is verified, showCliff goes false, and the cliff
// box + the FAQ amount sentence hide themselves.
const cliffByArea = isAreaJuris
  ? areas.map(a => ({
      area: a,
      amount: calcJurisdiction(feesData as any, juris.juris_id, 751, { area: a, verifiedOnly: true }).impactLow,
    }))
  : [];
const cliffAmount = isAreaJuris
  ? Math.max(...cliffByArea.map(c => c.amount))
  : calcJurisdiction(feesData as any, juris.juris_id, 751, { verifiedOnly: true }).impactLow;
const cliffLow = isAreaJuris
  ? Math.min(...cliffByArea.map(c => c.amount))
  : cliffAmount;
const showCliff = cliffAmount > 0;
const cliffDisplay = isAreaJuris && cliffLow !== cliffAmount
  ? `${fmtUSD(cliffLow)}–${fmtUSD(cliffAmount)}`
  : fmtUSD(cliffAmount);

const schoolLine = verifiedLines.find(l => l.item.category === "school");

// Area-count-aware wording: "not both" is only true for exactly two
// schedules (Ontario, Moreno Valley, Vacaville). One schedule needs no
// qualifier; three or more need "one of N" (Carlsbad has 3; Marin County
// and Clovis will have 13 and 5 once their area rows merge).
const areaNote =
  areas.length === 2
    ? "(a parcel pays one area schedule, not both)"
    : areas.length > 2
      ? `(a parcel pays one of ${areas.length} area schedules)`
      : "";

const rateLabel = (item: any): string => {
  if (item.method === "per_sqft") {
    const r = `$${item.rate_low}/sq ft`;
    return item.rate_high && item.rate_high !== item.rate_low
      ? `$${item.rate_low}–$${item.rate_high}/sq ft`
      : r;
  }
  if (item.method === "flat") return "flat fee";
  if (item.method === "pct_valuation") return `${(item.rate_low * 100).toFixed(2)}% of valuation`;
  return "see fee schedule";
};

// Rate text for verified rows feeCalc skips (no valuation basis on file).
// Unlike rateLabel, this never claims a "% of valuation" basis the schedule
// does not state: several pct_valuation rows are percentages of the permit
// fee (Diamond Bar plan check 85%, Marin surcharges, Campbell plan check
// 33%), and two old rows store the rate as whole percent-points (Campbell
// FI-297 rate 2 = 2%, FI-298 rate 33 = 33%) while newer rows store a decimal
// fraction (0.85 = 85%). The fee name's "(…% of …)" parenthetical, when
// present, is the schedule's own wording and wins.
const pctStr = (rate: number): string => {
  const v = rate > 1 ? rate : rate * 100;
  return String(parseFloat(v.toFixed(4)));
};
// fmtUSD rounds to whole dollars — wrong for schedule bases that carry
// cents ($2,738.66, $1,867.20). Keep cents only when the value has them.
const fmtMoney = (n: number): string =>
  "$" + n.toLocaleString("en-US", { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 });
const skippedRateLabel = (item: any): string => {
  if (item.method === "valuation_step") {
    if (item.step === 1) {
      return `${pctStr(item.rate_low)}% of valuation above ${fmtMoney(item.threshold)}`;
    }
    return `${fmtMoney(item.base)} + $${Number(item.rate_low).toFixed(2)} per $${Number(item.step).toLocaleString("en-US")} over ${fmtMoney(item.threshold)} valuation`;
  }
  if (item.method === "pct_valuation") {
    const pct = pctStr(item.rate_low);
    const paren = /\(([^)]*%[^)]*)\)/.exec(item.fee_name ?? "");
    if (paren) {
      return paren[1].replace(/,\s*LA County schedule$/, "").replace(/,\s*LA County$/, "");
    }
    const notes = item.notes ?? "";
    if (/of the building permit fee/i.test(notes)) return `${pct}% of permit fee`;
    if (/of permit & plan check/i.test(notes) || /of all building plan check and permit fees/i.test(notes)) return `${pct}% of permit & plan check`;
    return `${pct}% of valuation`;
  }
  if (item.method === "per_sqft") return `$${item.rate_low}/sq ft`;
  if (item.method === "flat") return "flat fee";
  return "see fee schedule";
};

const longTitle = `${juris.name} ADU Fees in 2026: Every Line Item, Sourced`;
// Keep <title> within ~60 chars so search results don't truncate it.
const title = longTitle.length <= 60 ? longTitle : `${juris.name} ADU Fees 2026, Line by Line`.length <= 60 ? `${juris.name} ADU Fees 2026, Line by Line` : `${juris.name} ADU Fees 2026`;
// Keep meta descriptions within ~160 chars so search results don't truncate
// them: both verified branches use the short "Verified ADU fees in" prefix,
// and the area branch drops the trailing sourcing sentence — the "one area
// schedule" note is the longer, accuracy-critical part. (cycle348)
const description = verifiedLines.length > 0
  ? isAreaJuris
    ? `Verified ADU fees in ${juris.name}, CA — ${fmtUSD(verifiedTotalLow)}${verifiedTotalHigh !== verifiedTotalLow ? `–${fmtUSD(verifiedTotalHigh)}` : ""} across areas for an ${SQFT} sq ft ADU${areaNote ? ` ${areaNote}` : ""}.`
    : `Verified ADU fees in ${juris.name}, CA — ${fmtUSD(verifiedTotalLow)} across ${verifiedLines.length} line item${verifiedLines.length === 1 ? "" : "s"} for an ${SQFT} sq ft ADU. Every figure links to its official source.`
  : skippedVerifiedLines.length > 0
    ? `ADU fees in ${juris.name}, CA — ${skippedVerifiedLines.length} verified fee rates on file (dollar amounts need your project's valuation). Every figure links to its official source.`
  : `ADU fees in ${juris.name}, CA — our researchers are verifying every line item against official sources. The 750 sq ft state-law cliff, explained.`;

const faqs = [
  {
    q: `Are impact fees waived for ADUs under 750 sq ft in ${juris.name}?`,
    a: `Yes. California law (Gov. Code \u00a766311.5) bars local agencies from charging impact fees on ADUs of 750 square feet or less. That applies in ${juris.name} the same as everywhere else in California.${showCliff ? ` At 751 sq ft, the impact fees we have verified for ${juris.name} total ${cliffDisplay} — the cliff is real here.` : ""}`,
  },
  {
    q: `Where do these ${juris.name} ADU fee numbers come from?`,
    a: "Every line item links to the official source document — the city or county fee schedule, the school district's developer-fee resolution, or the utility district's charges — with the date we last verified it. We publish no fee modeled, no fee guessed.",
  },
  ...(schoolLine
    ? [
        {
          q: `How much are school district fees for an ADU in ${juris.name}?`,
          a: `${fmtUSD(schoolLine.low)} for an ${SQFT} sq ft ADU (${rateLabel(schoolLine.item)}), per the district document linked in the table. Note: since January 1, 2026, ADUs under 500 sq ft are exempt from school fees under state law.`,
        },
      ]
    : []),
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} noindex={thinFeePage}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-8" data-backUrl="/fees/">
    <p class="text-sm font-mono uppercase tracking-wide opacity-60">
      {juris.county} County &middot; California
    </p>
    <h1 class="my-4 text-3xl font-bold sm:text-4xl">
      {juris.name} ADU Fees in 2026
    </h1>
    <p class="text-lg opacity-80">
      {verifiedLines.length > 0 ? (
        <>Every government fee we could verify for an ADU in {juris.name}, from
        official sources. Figures below are for an {SQFT} sq ft ADU unless noted.</>
      ) : skippedVerifiedLines.length > 0 ? (
        <>We have verified the rates for {skippedVerifiedLines.length} fee lines in {juris.name},
        but their dollar amounts depend on your project&apos;s valuation — which we don&apos;t
        have on file — so the table below lists the verified rates without a computed total.</>
      ) : (
        <>We have not published verified fee figures for {juris.name} yet.
        Our researchers verify every line item against its official source
        document before publishing — no fee modeled, no fee guessed.</>
      )}
    </p>
    <p class="mt-3 text-sm opacity-70">
      Every figure links to its official source document.
      {juris.last_verified && (
        <> Last verified {formatVerified(juris.last_verified)}.</>
      )}{" "}
      Fees are re-verified on a rolling schedule (next full pass Dec 2026).{" "}
      {/^https?:\/\//.test(juris.fee_schedule_url ?? "") && (
        <>
          <a
            href={juris.fee_schedule_url}
            target="_blank"
            rel="noopener"
            class="text-accent underline decoration-dashed underline-offset-4"
          >
            Official fee schedule &nearr;
          </a>{" "}
        </>
      )}
      <LinkButton
        class="underline decoration-dashed underline-offset-4"
        href="/methodology/"
      >
        How we price &rarr;
      </LinkButton>
      {result.lines.some(l => l.item.status === "verified" && l.kind !== "skipped") && (
        <>
          {" "}
          <LinkButton
            class="underline decoration-dashed underline-offset-4"
            href={`/downloads/estimate-${juris.juris_id.toLowerCase()}.xlsx`}
          >
            Download estimate (.xlsx) &darr;
          </LinkButton>
        </>
      )}
    </p>

    {juris.county === "Los Angeles" && juris.juris_id !== "LA-CITY" && (
      <p class="mt-3 text-sm opacity-70">
        {juris.name} is one of the cities in Los Angeles County — each city
        runs its own fee schedule. For the City of Los Angeles itself, see
        the{" "}
        <a
          href="/fees/la-city/"
          class="text-accent underline decoration-dashed underline-offset-4"
        >
          City of Los Angeles fee table &rarr;
        </a>
      </p>
    )}

    {verifiedLines.length > 0 || skippedVerifiedLines.length > 0 ? (
      <>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="border border-border rounded-lg p-4">
            <p class="text-sm opacity-60">Verified fees, {SQFT} sq ft ADU</p>
            <p class="mt-1 text-2xl font-bold tabular-nums">
              {verifiedLines.length > 0 ? (
                <>{fmtUSD(verifiedTotalLow)}
                {verifiedHasRange && verifiedTotalHigh !== verifiedTotalLow && `–${fmtUSD(verifiedTotalHigh)}`}</>
              ) : (
                <>—</>
              )}
            </p>
            <p class="mt-1 text-sm opacity-60">
              {verifiedLines.length > 0 ? (
                isAreaJuris
                  ? `range across areas — ${areaTotals.map(t => `${t.area} ${fmtUSD(t.low)}`).join(" · ")}${areas.length === 2 ? "; your parcel pays one area's schedule, not both" : areas.length > 2 ? `; your parcel pays one of ${areas.length} area schedules` : ""}`
                  : `across ${verifiedLines.length} line ${verifiedLines.length === 1 ? "item" : "items"}`
              ) : (
                `${skippedVerifiedLines.length} verified rates — dollar amounts need your project's valuation`
              )}
            </p>
          </div>
          <div class="border border-border rounded-lg p-4">
            <p class="text-sm opacity-60">The 750 sq ft cliff</p>
            <p class="mt-1 text-2xl font-bold tabular-nums">
              {showCliff ? cliffDisplay : "$0*"}
            </p>
            <p class="mt-1 text-sm opacity-60">
              {showCliff
                ? `impact fees at 751 sq ft${isAreaJuris ? ", by area" : ""} — $0 at 750 sq ft by state law`
                : `no verified impact fees on file yet`}
            </p>
          </div>
          <div class="border border-border rounded-lg p-4">
            <p class="text-sm opacity-60">Your exact size</p>
            <p class="mt-1 text-lg font-semibold">
              <LinkButton
                class="text-accent font-semibold underline decoration-dashed underline-offset-4"
                href={`/compare/?j=${juris.juris_id}&sqft=${SQFT}#fee-calculator`}
              >
                Calculate for your ADU &rarr;
              </LinkButton>
            </p>
            <p class="mt-1 text-sm opacity-60">
              same data, any square footage
            </p>
          </div>
        </div>

        {verifiedLines.length > 0 && (
          <>
        <h2 class="mt-10 text-2xl font-semibold">Fee table</h2>
        <p class="mt-2 text-sm opacity-70">
          Amounts computed for an {SQFT} sq ft ADU from each item's published
          rate. "Exempt" lines are $0 by state law at this size.{
            isAreaJuris && (
              <>
                {" "}This jurisdiction has{" "}
                {areas.length === 2 ? "two" : areas.length} area schedules — a
                parcel pays one, not{" "}
                {areas.length === 2 ? "both" : `all ${areas.length}`} — so{" "}
                {areas.length === 2 ? "both" : "all"} schedules are listed
                below and the total above is the range across areas, not the
                sum of all rows. Dwelling-base impact fees are prorated at an
                assumed 1,600 sq ft primary dwelling; use the calculator to
                enter your actual primary size.
              </>
            )
          }
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-border text-left">
                <th class="py-2 pe-3 font-semibold">Fee</th>
                <th class="py-2 pe-3 font-semibold">Category</th>
                <th class="py-2 pe-3 font-semibold text-right">Rate</th>
                <th class="py-2 pe-3 font-semibold text-right">{SQFT} sq ft</th>
                <th class="py-2 font-semibold text-right">Source</th>
              </tr>
            </thead>
            <tbody>
              {verifiedLines.map(l => (
                <tr class="border-b border-border">
                  <td class="py-2 pe-3 font-medium">{l.item.fee_name}</td>
                  <td class="py-2 pe-3 opacity-70">{categoryLabel(l.item.category)}</td>
                  <td class="py-2 pe-3 text-right tabular-nums opacity-70">
                    {rateLabel(l.item)}
                  </td>
                  <td class="py-2 pe-3 text-right tabular-nums font-bold">
                    {l.kind === "exempt" ? (
                      <span title={l.reason ?? undefined}>$0 <span class="font-normal opacity-60">(exempt)</span></span>
                    ) : (
                      fmtUSD(l.low) + (l.high != null && l.high !== l.low ? `–${fmtUSD(l.high)}` : "")
                    )}
                  </td>
                  <td class="py-2 text-right">
                    {l.item.source_url ? (
                      <a
                        href={l.item.source_url}
                        target="_blank"
                        rel="noopener"
                        class="text-accent underline decoration-dashed underline-offset-4"
                        title={`${l.item.source_note ?? "Official source"} — verified ${l.item.last_verified ?? "n/a"}`}
                      >
                        official doc &nearr;
                      </a>
                    ) : (
                      <span class="opacity-50">—</span>
                    )}
                    {l.item.last_verified && (
                      <span class="block text-xs opacity-60">
                        verified {formatVerified(l.item.last_verified)}
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm opacity-60">
          These are the line items we have verified so far — not a complete
          bill. Site-specific charges (utility laterals, soil work) vary by lot.{" "}
          <LinkButton
            class="underline decoration-dashed underline-offset-4"
            href="/methodology/"
          >
            How we price &rarr;
          </LinkButton>
        </p>
          </>
        )}

        {skippedVerifiedLines.length > 0 && (
          <>
            <h3 class="mt-8 text-xl font-semibold">Verified rates — amounts need your project&apos;s valuation</h3>
            <p class="mt-2 text-sm opacity-70">
              These rates are verified from official sources, but the dollar
              amount depends on your project&apos;s valuation, which we don&apos;t have
              on file for {juris.name}. The table lists the verified rate, the
              source, and the verification date — no total is computed for
              these lines, and they are excluded from the total above.
            </p>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-border text-left">
                    <th class="py-2 pe-3 font-semibold">Fee</th>
                    <th class="py-2 pe-3 font-semibold">Category</th>
                    <th class="py-2 pe-3 font-semibold text-right">Rate</th>
                    <th class="py-2 pe-3 font-semibold text-right">{SQFT} sq ft</th>
                    <th class="py-2 font-semibold text-right">Source</th>
                  </tr>
                </thead>
                <tbody>
                  {skippedVerifiedLines.map(l => (
                    <tr class="border-b border-border">
                      <td class="py-2 pe-3 font-medium">{l.item.fee_name}</td>
                      <td class="py-2 pe-3 opacity-70">{categoryLabel(l.item.category)}</td>
                      <td class="py-2 pe-3 text-right tabular-nums opacity-70">
                        {skippedRateLabel(l.item)}
                      </td>
                      <td class="py-2 pe-3 text-right tabular-nums font-bold" title={l.reason ?? "No valuation basis on file for this jurisdiction."}>
                        —
                      </td>
                      <td class="py-2 text-right">
                        {l.item.source_url ? (
                          <a
                            href={l.item.source_url}
                            target="_blank"
                            rel="noopener"
                            class="text-accent underline decoration-dashed underline-offset-4"
                            title={`${l.item.source_note ?? "Official source"} — verified ${l.item.last_verified ?? "n/a"}`}
                          >
                            official doc &nearr;
                          </a>
                        ) : (
                          <span class="opacity-50">—</span>
                        )}
                        {l.item.last_verified && (
                          <span class="block text-xs opacity-60">
                            verified {formatVerified(l.item.last_verified)}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </>
    ) : (
      <div class="mt-6 border border-border rounded-lg p-6">
        <h2 class="text-xl font-semibold">Verification in progress</h2>
        <p class="mt-2 opacity-80">
          Our researchers are working through {juris.name}'s official fee
          schedules now. We publish a line item only after we have read the
          source document — no fee modeled, no fee guessed. Check back soon, or run the
          calculator for the statewide baseline in the meantime.
        </p>
        <p class="mt-4">
          <LinkButton
            href={`/compare/?j=${juris.juris_id}&sqft=${SQFT}#fee-calculator`}
            class="bg-accent text-white font-semibold px-5 py-3 rounded"
          >
            Open the fee calculator &rarr;
          </LinkButton>
        </p>
      </div>
    )}

    {pendingLines.length + skippedPendingLines.length > 0 && (
      <div class="mt-8">
        <h2 class="text-xl font-semibold">Still verifying</h2>
        <p class="mt-2 text-sm opacity-70">
          Found in official documents, amounts not yet confirmed — listed
          without figures until verification completes.
        </p>
        <ul class="mt-3 list-disc ps-5 space-y-1 text-sm">
          {pendingLines.map(l => (
            <li>
              <span class="font-medium">{l.item.fee_name}</span>
              <span class="opacity-60"> — {categoryLabel(l.item.category)}</span>
            </li>
          ))}
          {skippedPendingLines.map(l => (
            <li>
              <span class="font-medium">{l.item.fee_name}</span>
              <span class="opacity-60"> — {categoryLabel(l.item.category)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {showCliff && (
      <div class="mt-8 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3">
        <p class="font-semibold">The 750 sq ft cliff in {juris.name}</p>
        <p class="mt-1 text-sm opacity-90">
          At 751 sq ft, the impact fees above total {cliffDisplay}. At
          750 sq ft, state law (Gov. Code &sect;66311.5) sets them to $0.
          One square foot can be worth {cliffDisplay} here — size your
          ADU accordingly.
        </p>
      </div>
    )}

    <div class="mt-8 rounded-lg border border-border px-4 py-3">
      <p class="font-semibold">What changes on January 1, 2027</p>
      <p class="mt-1 text-sm opacity-90">
        Two state laws rewrite parts of this table. <strong>SB 1117</strong>{" "}
        (Chapter 809) re-bases covered impact fees for up to two ADUs on only
        the square footage above 750 — at 800 sq ft, most impact-fee lines
        shrink to a 50 sq ft basis. School developer fees and water/sewer
        connection or capacity charges are not covered and do not change.{" "}
        <strong>AB 956</strong> (Chapter 791) makes two detached ADUs per
        single-family lot a ministerial approval.{" "}
        <a class="text-accent font-semibold underline decoration-dashed underline-offset-4" href={`/sb-1117/${juris.juris_id.toLowerCase()}/`}>{juris.name}: 2026 vs 2027, line by line &rarr;</a>{" "}
        Details:{" "}
        <a class="text-accent underline decoration-dashed underline-offset-4" href="/posts/sb-1117-kills-750-sq-ft-cliff/">SB 1117 and the 750 sq ft cliff</a>{" "}
        &middot;{" "}
        <a class="text-accent underline decoration-dashed underline-offset-4" href="/posts/ab-956-two-adus-one-lot/">AB 956: two ADUs on one lot</a>
      </p>
    </div>

    <h2 class="mt-10 text-2xl font-semibold">Common questions</h2>
    <div class="mt-4 space-y-4">
      {faqs.map(f => (
        <div class="border border-border rounded-lg p-4">
          <p class="font-semibold">{f.q}</p>
          <p class="mt-1 text-sm opacity-80">{f.a}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <LinkButton
        href={`/compare/?j=${juris.juris_id}&sqft=${SQFT}#fee-calculator`}
        class="bg-accent text-white font-semibold px-5 py-3 rounded"
      >
        Calculate your exact fees &rarr;
      </LinkButton>
      {postSlug && (
        <LinkButton
          href={`/posts/${postSlug}/`}
          class="border border-border px-5 py-3 rounded font-medium"
        >
          Read the {juris.name} cost breakdown &rarr;
        </LinkButton>
      )}
    </div>

    <div class="mt-8 border border-border rounded-lg p-4">
      <p class="font-semibold">Embed this fee card</p>
      <p class="mt-1 text-sm opacity-70">
        Bloggers, realtors, journalists: drop this city's live fee card into
        your page. Numbers stay current; every figure links back to its source.
      </p>
      <pre class="mt-3 overflow-x-auto rounded bg-black/5 p-3 text-xs"><code>{`<iframe src="https://everylineitem.com/embed/fee-card/?j=${juris.juris_id}" width="100%" height="240" style="border:0" loading="lazy" title="${juris.name} ADU fees"></iframe>`}</code></pre>
    </div>

    {
      siblingJuris && (
        <NextReads
          links={[
            {
              href: `/fees/${siblingJuris.juris_id.toLowerCase()}/`,
              label: `${siblingJuris.name} ADU fees`,
            },
            {
              href: `/sb-1117/${juris.juris_id.toLowerCase()}/`,
              label: `SB 1117 savings in ${juris.name}`,
            },
          ]}
          cta={TOOLS["property-tax"]}
          subscribe={{
            href: "/fee-index/#index-alert-heading",
            label: `Get an email when ${juris.name}'s fees change`,
          }}
        />
      )
    }

    <PrevNext
      prev={
        prevJuris
          ? {
              href: `/fees/${prevJuris.juris_id.toLowerCase()}/`,
              label: `${prevJuris.name} ADU fees`,
            }
          : null
      }
      next={
        nextJuris
          ? {
              href: `/fees/${nextJuris.juris_id.toLowerCase()}/`,
              label: `${nextJuris.name} ADU fees`,
            }
          : null
      }
    />
  </main>
  <Footer />
</Layout>
