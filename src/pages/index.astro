---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import FeeAlertSignup from "@/components/FeeAlertSignup.astro";
import RecentlyViewed from "@/components/RecentlyViewed.astro";
import changelog from "@/data/fee-changelog.json";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { parseVerified, formatVerified } from "@/utils/formatVerified";

dayjs.extend(utc);
dayjs.extend(timezone);

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestPosts = [...sortedPosts]
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  )
  .slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");

const homeTitle = "How Much Does an ADU Cost in California? | Every Line Item";

// Stronger share/preview image than generic default-og.jpg (post/compare OG unchanged)
const homeOgImage = new URL(
  "images/pinterest/800-sq-ft-adu-cost.png",
  config.site.url
).href;

const siteUrl = config.site.url.endsWith("/")
  ? config.site.url
  : `${config.site.url}/`;

// Trust + Fee Index band — computed from fees.json so the homepage never
// goes stale when new jurisdictions merge (PR #95 lesson on fee-index).
const jurisCount = (feesData.jurisdictions as any[]).filter(
  j => j.juris_id !== "LA-BASE"
).length;
const verifiedCount = (feesData.fee_items as any[]).filter(
  i => i.status === "verified" && i.juris_id !== "LA-BASE"
).length;
const schoolFees = (feesData.fee_items as any[])
  .filter(i => i.status === "verified" && i.juris_id !== "LA-BASE" && i.category === "school" && i.method === "per_sqft")
  .sort((a, b) => a.rate_low - b.rate_low);
const fmtUSD = (n: number) => "$" + n.toLocaleString("en-US");

// Published city cost breakdowns — the "how much does an ADU cost" answer,
// computed from the posts themselves so it can never drift from the series.
// sortedPosts is already published-only (postFilter drops drafts and
// scheduled posts). City posts are the 800 sq ft standard; totalCost is a
// "$305,000" string, sometimes with a "*" floor marker or a range
// ("$309,000–$310,000") — parseTotal takes the first number, the low end.
const parseTotal = (s: unknown) => {
  if (typeof s !== "string") return null;
  // First number only: some totals are ranges ("$309,000–$310,000") —
  // taking the low end matches the floor framing. Stripping all
  // non-digits would concatenate the two ends into a nonsense figure.
  const m = s.match(/[\d,]+/);
  if (!m) return null;
  const n = Number(m[0].replace(/,/g, ""));
  return Number.isFinite(n) && n > 0 ? n : null;
};
const cityTotals = sortedPosts
  .filter(p => p.id.endsWith("-adu-cost"))
  .map(p => parseTotal((p.data as any).keyFacts?.totalCost))
  .filter((n): n is number => n !== null)
  .sort((a, b) => a - b);
const cityCount = cityTotals.length;
const cityMin = cityTotals[0] ?? 0;
const cityMax = cityTotals[cityTotals.length - 1] ?? 0;
const cityMedian =
  cityTotals.length % 2 === 1
    ? cityTotals[(cityTotals.length - 1) / 2]
    : Math.round(
        (cityTotals[cityTotals.length / 2 - 1] +
          cityTotals[cityTotals.length / 2]) /
          2
      );

// Largest verified SB 1117 saving at 1,000 sq ft — the 2027 angle,
// computed with the same engine as the SB 1117 pages (verified rows only;
// area jurisdictions report their max area). Guarded: $0 when no saving.
let maxSaving = 0;
let maxSavingJuris = "";
for (const j of (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE")) {
  const s = summarizeSB1117(feesData as any, j.juris_id, 1000);
  if (s.hasImpactLines && s.savings.high > maxSaving) {
    maxSaving = s.savings.high;
    maxSavingJuris = j.name as string;
  }
}

// Meta description (also OG + ItemList JSON-LD): answers the head query
// with the computed cost range, so it can never go stale. Keep ≤160 chars
// (149 at 40 cities / $299,000–$327,000 / median $312,500 — headroom kept
// so the count can grow without tripping E10).
const homeDescription =
  `An 800 sq ft ADU in California costs ${fmtUSD(cityMin)}–${fmtUSD(cityMax)} (median ${fmtUSD(cityMedian)}) across ${cityCount} city breakdowns — every fee verified against official schedules.`;

// School-fee spread — computed per jurisdiction from jurisStack's
// school field: the jurisdiction's combined school fee (elementary +
// high school shares summed at 800 sq ft). Comparing single district
// rows is wrong: one row can be only one share of a split district
// (Campbell's high school share FI-295 $1.61/sq ft is $1,288 alone,
// but the parcel also pays the elementary share FI-294 $3.77/sq ft —
// $4,304 combined). Same method as the Fee Index (PR #201).
// Jurisdictions whose only verified school row is a partial
// (high school) share are excluded from the low end:
// - LOS-GATOS: FI-182 LGSUHSD high school share only ($1.66/sq ft)
// - SARATOGA: FI-248 LGSUHSD high school share only ($1.66/sq ft)
// - EL-CENTRO: EL-CENTRO-NEW-01 CUHSD high school share only ($1.66/sq ft)
// - ONTARIO: FI-319 Chaffey HSD 9-12 share only ($1.67/sq ft)
// - LOS-ALTOS: FI-223 MVLA HSD high school share only ($1.72/sq ft;
//   elementary share unverified)
// - CHULA-VISTA: FI-269 Sweetwater HSD share only ($3.01/sq ft);
//   elementary share unverified
const PARTIAL_SCHOOL_JURIS = new Set([
  "LOS-GATOS",
  "SARATOGA",
  "EL-CENTRO",
  "ONTARIO",
  "LOS-ALTOS",
  "CHULA-VISTA",
]);
const jurisName = new Map(
  (feesData.jurisdictions as any[]).map(j => [j.juris_id, j.name as string])
);
// Largest verified per-sq-ft school share per jurisdiction — the source
// link for a combined figure points at its biggest share's document.
const largestSchoolRow = new Map<string, any>();
for (const i of schoolFees) {
  const prev = largestSchoolRow.get(i.juris_id);
  if (!prev || i.rate_low > prev.rate_low) largestSchoolRow.set(i.juris_id, i);
}
const schoolByJuris = new Map<string, number>();
for (const j of (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE")) {
  const stack = jurisStack(feesData as any, j.juris_id, 800);
  if (stack.school != null) schoolByJuris.set(j.juris_id, stack.school);
}
// Cheapest 5 + priciest 5 jurisdictions by combined school fee, computed
// from fees.json so the chart can never drift from the Fee Index again.
// Honest 0-based axis: the story is fee variance, not total-cost variance.
const schoolRows = [...schoolByJuris.entries()]
  .filter(([j]) => !PARTIAL_SCHOOL_JURIS.has(j))
  .sort((a, b) => a[1] - b[1])
  .map(([j, total]) => ({
    juris: jurisName.get(j) ?? j,
    rate: total / 800,
    total,
    source: (largestSchoolRow.get(j)?.source_url ?? "") as string,
  }));
const schoolLow = schoolRows[0].total;
const schoolHigh = schoolRows[schoolRows.length - 1].total;
const feeSpread = [...schoolRows.slice(0, 5), ...schoolRows.slice(-5)].map(c => ({
  ...c,
  totalLabel: "$" + c.total.toLocaleString("en-US"),
  rateLabel: "$" + c.rate.toFixed(2) + "/sq ft",
  barWidth: Math.round((c.total / schoolHigh) * 100) + "%",
}));

// Jurisdiction picker for the hero — every jurisdiction in the fee matrix,
// deep-linking into /compare/ with prefilled params.
import feesData from "@/data/fees.json";
import { calcJurisdiction, jurisAreas, jurisStack } from "@/lib/feeCalc";
import { summarizeSB1117 } from "@/lib/sb1117Pages";
const heroJurisdictions = [...feesData.jurisdictions]
  .sort((a, b) => a.name.localeCompare(b.name, "en-US"))
  .map(j => ({ id: j.juris_id, name: j.name }));
const feeRegions = [
  ...new Set(
    (feesData.jurisdictions as any[])
      .filter(j => j.juris_id !== "LA-BASE")
      .map(j => j.region as string)
  ),
].sort((a, b) => a.localeCompare(b, "en-US"));

// Biggest verified 750 sq ft cliff, computed from the same engine as the
// calculator — never hardcoded (PR #95 lesson). Dwelling-base lines prorate
// at the 1,600 sq ft default primary; area jurisdictions take their max area.
let topCliffJuris = "";
let topCliff = 0;
for (const j of (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE")) {
  const areas = jurisAreas(feesData as any, j.juris_id);
  const variants: (string | null)[] = areas.length > 0 ? areas : [null];
  for (const a of variants) {
    const r = calcJurisdiction(feesData as any, j.juris_id, 751, {
      area: a,
      verifiedOnly: true,
    });
    if (r.impactLow > topCliff) {
      topCliff = r.impactLow;
      topCliffJuris = j.name as string;
    }
  }
}

// Trust line — newest verification date across VERIFIED fee items only.
// (All-items scope pulled the date from to_verify rows — e.g. 5 Nov 2026
// from Clovis — while the numbers on this page all come from verified rows,
// whose newest date is 24 Oct 2026. Same scope as /fee-index/.)
const latestVerifiedRaw = feesData.fee_items
  .filter(i => i.status === "verified")
  .map(i => i.last_verified as string)
  .filter(Boolean)
  .sort((a, b) => parseVerified(b) - parseVerified(a))[0];
const latestVerified = formatVerified(latestVerifiedRaw);

// "What the numbers say" — editorial reading of the computed facts above
// (AdSense "low value" work: the homepage states what the data means,
// not just what it lists). Every figure comes from fees.json at build
// time, never hardcoded (PR #95 lesson). Same math as the Fee Index:
// the spread is per-jurisdiction combined school fees; the ceiling count
// is verified school rows at the $5.38 Level I cap.
const lowJuris = schoolRows[0].juris;
const highJuris = schoolRows[schoolRows.length - 1].juris;
const schoolRatio = (schoolHigh / schoolLow).toFixed(1);
const districtsAtCeiling = schoolFees.filter(s => s.rate_low === 5.38).length;
const districtsVerified = schoolFees.length;
// Lowest COMBINED rate (schoolRows[0]): single-row rates mislead here —
// the cheapest row is a high-school share ($1.34, AVUHSD), not a
// district's rate. The combined low end is Laguna Beach, $2.05/sq ft.
const lowCombinedRate = schoolRows[0].rate;
const maxSchool = schoolFees[schoolFees.length - 1];
const maxSchoolJuris = jurisName.get(maxSchool.juris_id) ?? maxSchool.juris_id;

// Browse index — replaces the old link-dump paragraph
const regions = [
  {
    name: "LA County",
    cities: [
      { label: "County hub", slug: "los-angeles-county-adu-cost" },
      { label: "Long Beach", slug: "long-beach-adu-cost" },
      { label: "Glendale", slug: "glendale-adu-cost" },
      { label: "Burbank", slug: "burbank-adu-cost" },
      { label: "Torrance", slug: "torrance-adu-cost" },
      { label: "Lakewood", slug: "lakewood-adu-cost" },
    ],
  },
  {
    name: "Orange County",
    cities: [
      { label: "Anaheim", slug: "anaheim-adu-cost" },
      { label: "Fullerton", slug: "fullerton-adu-cost" },
      { label: "Garden Grove", slug: "garden-grove-adu-cost" },
      { label: "Laguna Beach", slug: "laguna-beach-adu-cost" },
    ],
  },
  {
    name: "Bay Area",
    cities: [
      { label: "San Francisco", slug: "san-francisco-adu-cost" },
      { label: "San Jose", slug: "san-jose-bay-area-adu-cost" },
      { label: "Oakland", slug: "oakland-adu-cost" },
    ],
  },
  {
    name: "Inland & Central",
    cities: [
      { label: "Riverside", slug: "riverside-adu-cost" },
      { label: "Sacramento", slug: "sacramento-adu-cost" },
      { label: "Santa Maria", slug: "santa-maria-adu-cost" },
      { label: "San Bernardino", slug: "san-bernardino-adu-cost" },
      { label: "Fontana", slug: "fontana-adu-cost" },
    ],
  },
  {
    name: "San Diego",
    cities: [
      { label: "San Diego", slug: "san-diego-adu-cost" },
      { label: "Chula Vista", slug: "chula-vista-adu-cost" },
      { label: "Oceanside", slug: "oceanside-adu-cost" },
      { label: "Encinitas", slug: "encinitas-adu-cost" },
    ],
  },
];

const buildTypes = [
  { label: "400 sq ft ADU", slug: "400-sq-ft-adu-cost-california" },
  { label: "800 sq ft ADU", slug: "800-sq-ft-adu-cost-california" },
  { label: "JADU", slug: "jadu-cost-california" },
  { label: "Garage conversion", slug: "garage-conversion-adu-cost-california" },
  { label: "Modular vs site-built", slug: "modular-vs-site-built-adu-cost-california" },
  { label: "Prefab brands compared", slug: "prefab-adu-brands-compared-california" },
  { label: "Coastal vs inland", slug: "coastal-vs-inland-adu-cost-california" },
];

const guides = [
  { label: "How to read an ADU bid", slug: "how-to-read-adu-bid" },
  { label: "Soft costs & permits", slug: "adu-soft-costs-permits-california" },
  { label: "All-in cost", slug: "adu-all-in-cost-california" },
  { label: "Rent payback & ROI", slug: "adu-rent-payback-roi-california" },
  { label: "US fee shockers", slug: "us-adu-fee-shockers" },
];

const videos = [
  {
    kind: "Short",
    date: "Nov 17, 2026",
    title: "California ADU Permit Fees, Ranked: $1,006 to $19,200",
    dek: "Riverside $1,006 to Oakland $12,800–$19,200 for the same 800 sq ft ADU — a 19x spread for the identical stack of paper. SB 1117 doesn't touch permit fees.",
    url: "https://youtube.com/shorts/PzJtrw4A7cM",
  },
  {
    kind: "Short",
    date: "Nov 17, 2026",
    title: "Does Your ADU Need Solar? Probably Not — Title 24 Explained",
    dek: "Most ADUs don't need solar. Title 24 requires panels only on new detached ADUs — and five exceptions can remove the requirement entirely.",
    url: "https://youtube.com/shorts/zkB3xW6kB_A",
  },
];

const seriesItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "California ADU cost series",
  description: homeDescription,
  numberOfItems: sortedPosts.length,
  itemListElement: sortedPosts.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`posts/${post.id}/`, siteUrl).href,
    name: post.data.title,
  })),
};

// Homepage FAQ — one source for the visible list and the FAQPage schema
// below, so the two can never drift. Plain-text answers only (links are
// rendered separately); every figure is computed above, never typed in.
const sb1117SavingClause =
  maxSaving > 0
    ? ` At 1,000 sq ft the largest verified saving is ${fmtUSD(maxSaving)} in ${maxSavingJuris}.`
    : "";
const homeFaqs: { q: string; a: string; href: string; label: string }[] = [
  {
    q: "How much does an ADU cost in California?",
    a: `Across the ${cityCount} city breakdowns published here, an 800 sq ft detached backyard home runs ${fmtUSD(cityMin)}–${fmtUSD(cityMax)} all-in, median ${fmtUSD(cityMedian)}. Construction is modeled; the government charges are verified line items.`,
    href: "/compare/",
    label: "Price your city",
  },
  {
    q: "What does the city charge for an ADU?",
    a: "Three kinds of government charges: school district assessments, impact levies for parks and traffic, and permit plus water and sewer connection charges. Every figure on this site traces to the official schedule or resolution that set it.",
    href: "/fee-index/",
    label: "Browse the Fee Index",
  },
  {
    q: "Do I pay school fees on a small ADU?",
    a: "Not under 500 sq ft — state law deems the fee $0 below that size. Between 500 and 750 sq ft you owe the school assessment but no impact fees. Above 750 sq ft, both apply.",
    href: "/posts/adu-school-fees-explained/",
    label: "Why school fees vary",
  },
  {
    q: "What changes on January 1, 2027?",
    a: `SB 1117 taxes only the area above 750 sq ft for a homeowner's first two ADUs on a parcel.${sb1117SavingClause} School fees and connection charges are untouched.`,
    href: "/sb-1117/",
    label: "See your city's saving",
  },
  {
    q: "What will an ADU add to my property tax?",
    a: "Only the new construction is reassessed — the existing home's assessed value does not change. The added value depends on your county's rate and your build's value, not its cost.",
    href: "/property-tax/",
    label: "Estimate your tax",
  },
  {
    q: "Why do ADU fees vary so much between cities?",
    a: "The same 800 sq ft ADU owes $1,006 for a building permit in Riverside and $12,800–$19,200 in Oakland — a 19× spread on the identical unit — because most cities price permits from an assumed construction valuation, not a flat schedule. School fees vary the same way: $1,792 in Pasadena against $4,304 in Campbell, set by school district boundaries rather than city limits.",
    href: "/posts/adu-permit-fees-ranked/",
    label: "See the permit ranking",
  },
  {
    q: "What if my city's fee isn't listed?",
    a: `We leave it blank and mark it "verify with city" rather than estimate — a fee we cannot verify from an official source is not a number we publish. The index covers ${jurisCount} jurisdictions and grows batch by batch as new fee schedules are checked. A missing schedule or a correction can be sent to corrections@everylineitem.com.`,
    href: "/fee-index/",
    label: "Browse the Fee Index",
  },
  {
    q: "How often is the data updated?",
    a: "Every fee line is re-checked against its official source on a published quarterly schedule, and the next full re-verification is December 2026. Changes are logged in the public change log, newest first, with the date each figure was last checked.",
    href: "/changes/",
    label: "See what changed",
  },
];

const homeFaqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const formatShortDate = (d: string | Date) =>
  dayjs(d).tz("America/Los_Angeles").format("MMM D, YYYY");
---

<Layout title={homeTitle} description={homeDescription} ogImage={homeOgImage}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(seriesItemList)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(homeFaqPage)}
    />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    {/* HERO — headline + city comparison table */}
    <section id="hero" aria-labelledby="hero-heading" class="border-border border-b pt-8 pb-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-sm font-mono uppercase tracking-wide opacity-60">
            CA ADU Costs
          </p>
          <h1 id="hero-heading" class="my-4 text-3xl font-bold sm:my-6 sm:text-4xl">
            California ADU Fee Index
          </h1>
          <p class="text-xl font-medium sm:text-2xl">
            Where every ADU dollar actually goes.
          </p>
          <p class="mt-4">
            Line-item cost breakdowns for real California builds. Six phases,
            every fee, every city — so you can check a contractor's number
            before you sign.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <LinkButton
              href="/compare/"
              class="bg-accent text-white font-semibold px-5 py-3 rounded"
            >
              Verify a contractor quote &rarr;
            </LinkButton>
            <LinkButton
              href="/downloads/adu-benchmark-ranges-2026-q3.csv"
              class="border border-border px-5 py-3 rounded font-medium"
            >
              Free 2026 Q3 benchmark CSV
            </LinkButton>
          </div>
          {/* Fee lookup — jurisdiction + size, deep-linked into /compare/ */}
          <form
            id="hero-fee-lookup"
            class="mt-4 flex flex-wrap items-end gap-2"
            aria-label="Look up fees for your jurisdiction"
          >
            <label class="block">
              <span class="text-sm font-medium opacity-70">Your jurisdiction</span>
              <input
                type="search"
                data-juris-filter="hero-juris"
                placeholder="Type to filter cities…"
                aria-label="Filter jurisdictions"
                class="border-border bg-background focus:border-accent mt-1 block w-64 rounded border px-2 py-2 text-sm"
              />
              <select
                id="hero-juris"
                class="border-border bg-background focus:border-accent mt-1 block w-64 rounded border px-2 py-2 text-sm"
              >
                <option value="" disabled selected>Choose your jurisdiction…</option>
                {heroJurisdictions.map(j => (
                  <option value={j.id}>{j.name}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-medium opacity-70">Size</span>
              <span class="mt-1 flex items-center gap-1">
                <input
                  id="hero-sqft"
                  type="number"
                  value="800"
                  min="100"
                  max="2000"
                  step="1"
                  class="border-border bg-background focus:border-accent w-24 rounded border px-2 py-2 text-sm tabular-nums"
                />
                <span class="text-sm opacity-70">sq ft</span>
              </span>
            </label>
            <button
              type="submit"
              class="bg-accent rounded px-4 py-2 font-semibold text-white"
            >
              See my fees &rarr;
            </button>
          </form>
          <p class="mt-3 text-sm opacity-70">
            Browse fees by region:{" "}
            {feeRegions.map((r, idx) => (
              <span>
                {idx > 0 && " · "}
                <a
                  href={`/fees/#${r.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-accent underline decoration-dashed underline-offset-4"
                >
                  {r}
                </a>
              </span>
            ))}{" "}
            ·{" "}
            <a
              href="/fees/"
              class="text-accent underline decoration-dashed underline-offset-4"
            >
              All cities &rarr;
            </a>
          </p>
          <p class="mt-3 text-sm opacity-70">
            {jurisCount} jurisdictions · every figure links to
            its official source · Fees last verified: {latestVerified} · no email needed.{" "}
            <LinkButton
              class="underline decoration-dashed underline-offset-4"
              href="/methodology/"
            >
              How we price &rarr;
            </LinkButton>
          </p>
          {
            socials.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  {t.home.socialLinks}:
                </div>
                <Socials />
              </div>
            )
          }
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="mt-4 inline-flex items-center gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="text-sm">RSS Feed</span>
          </a>
        </div>

