---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import FeeAlertSignup from "@/components/FeeAlertSignup.astro";
import changelog from "@/data/fee-changelog.json";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestPosts = [...sortedPosts]
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  )
  .slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");

const homeTitle = "California ADU Cost Breakdowns | Every Line Item";
const homeDescription =
  "Line-item California ADU costs by phase: 800 vs 400 sq ft, garage conversion, soft costs, modular, coastal, San Diego, Bay Area, and ROI. Compare any two builds side by side.";

// Stronger share/preview image than generic default-og.jpg (post/compare OG unchanged)
const homeOgImage = new URL(
  "images/pinterest/800-sq-ft-adu-cost.png",
  config.site.url
).href;

const siteUrl = config.site.url.endsWith("/")
  ? config.site.url
  : `${config.site.url}/`;

// Trust + Fee Index band — computed from fees.json so the homepage never
// goes stale when new jurisdictions merge (PR #95 lesson on fee-index).
const jurisCount = (feesData.jurisdictions as any[]).filter(
  j => j.juris_id !== "LA-BASE"
).length;
const verifiedCount = (feesData.fee_items as any[]).filter(
  i => i.status === "verified" && i.juris_id !== "LA-BASE"
).length;
const schoolFees = (feesData.fee_items as any[])
  .filter(i => i.status === "verified" && i.juris_id !== "LA-BASE" && i.category === "school" && i.method === "per_sqft")
  .sort((a, b) => a.rate_low - b.rate_low);
const schoolLow = Math.round(schoolFees[0].rate_low * 800);
const schoolHigh = Math.round(schoolFees[schoolFees.length - 1].rate_low * 800);
const fmtUSD = (n: number) => "$" + n.toLocaleString("en-US");

// School-fee spread — one fee line, set by the school district, identical
// math for every jurisdiction (rate × 800 sq ft). Honest 0-based axis:
// the story is fee variance, not total-cost variance. Cheapest 5 + priciest 5
// jurisdictions with verified per-sq-ft school-fee line items, computed from
// fees.json so the chart can never drift from the Fee Index again.
const jurisName = new Map(
  (feesData.jurisdictions as any[]).map(j => [j.juris_id, j.name as string])
);
const schoolByJuris = new Map<string, any>();
for (const i of schoolFees) {
  if (!schoolByJuris.has(i.juris_id)) schoolByJuris.set(i.juris_id, i);
}
const schoolRows = [...schoolByJuris.values()].map(i => ({
  juris: jurisName.get(i.juris_id) ?? i.juris_id,
  rate: i.rate_low as number,
  total: Math.round((i.rate_low as number) * 800),
  source: i.source_url as string,
}));
const feeSpread = [...schoolRows.slice(0, 5), ...schoolRows.slice(-5)].map(c => ({
  ...c,
  totalLabel: "$" + c.total.toLocaleString("en-US"),
  rateLabel: "$" + c.rate.toFixed(2) + "/sq ft",
  barWidth: Math.round((c.total / schoolHigh) * 100) + "%",
}));

// Jurisdiction picker for the hero — every jurisdiction in the fee matrix,
// deep-linking into /compare/ with prefilled params.
import feesData from "@/data/fees.json";
import { calcJurisdiction, jurisAreas } from "@/lib/feeCalc";
const heroJurisdictions = [...feesData.jurisdictions]
  .sort((a, b) => a.name.localeCompare(b.name, "en-US"))
  .map(j => ({ id: j.juris_id, name: j.name }));
const feeRegions = [
  ...new Set(
    (feesData.jurisdictions as any[])
      .filter(j => j.juris_id !== "LA-BASE")
      .map(j => j.region as string)
  ),
].sort((a, b) => a.localeCompare(b, "en-US"));

// Biggest verified 750 sq ft cliff, computed from the same engine as the
// calculator — never hardcoded (PR #95 lesson). Dwelling-base lines prorate
// at the 1,600 sq ft default primary; area jurisdictions take their max area.
let topCliffJuris = "";
let topCliff = 0;
for (const j of (feesData.jurisdictions as any[]).filter(j => j.juris_id !== "LA-BASE")) {
  const areas = jurisAreas(feesData as any, j.juris_id);
  const variants: (string | null)[] = areas.length > 0 ? areas : [null];
  for (const a of variants) {
    const r = calcJurisdiction(feesData as any, j.juris_id, 751, {
      area: a,
      verifiedOnly: true,
    });
    if (r.impactLow > topCliff) {
      topCliff = r.impactLow;
      topCliffJuris = j.name as string;
    }
  }
}

// Trust line — newest verification date across all fee items.
// last_verified mixes ISO ("2026-10-16") and human ("7 Oct 2026") formats,
// so parse both before comparing.
const MONTHS: Record<string, number> = {
  Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
  Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11,
};
const parseVerified = (s: string): number => {
  const iso = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if (iso) return Date.UTC(+iso[1], +iso[2] - 1, +iso[3]);
  const human = /^(\d{1,2}) ([A-Za-z]{3}) (\d{4})$/.exec(s);
  if (human && MONTHS[human[2]] !== undefined)
    return Date.UTC(+human[3], MONTHS[human[2]], +human[1]);
  return 0;
};
const latestVerifiedRaw = feesData.fee_items
  .map(i => i.last_verified as string)
  .filter(Boolean)
  .sort((a, b) => parseVerified(b) - parseVerified(a))[0];
// Display newest-first value as "16 Oct 2026" regardless of stored format.
const latestVerified = (() => {
  const t = parseVerified(latestVerifiedRaw);
  if (!t) return latestVerifiedRaw;
  const d = new Date(t);
  const names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${d.getUTCDate()} ${names[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
})();

// Browse index — replaces the old link-dump paragraph
const regions = [
  {
    name: "LA County",
    cities: [
      { label: "County hub", slug: "los-angeles-county-adu-cost" },
      { label: "Long Beach", slug: "long-beach-adu-cost" },
      { label: "Glendale", slug: "glendale-adu-cost" },
      { label: "Burbank", slug: "burbank-adu-cost" },
      { label: "Torrance", slug: "torrance-adu-cost" },
    ],
  },
  {
    name: "Orange County",
    cities: [
      { label: "Anaheim", slug: "anaheim-adu-cost" },
      { label: "Fullerton", slug: "fullerton-adu-cost" },
      { label: "Garden Grove", slug: "garden-grove-adu-cost" },
    ],
  },
  {
    name: "Bay Area",
    cities: [
      { label: "San Francisco", slug: "san-francisco-adu-cost" },
      { label: "San Jose", slug: "san-jose-bay-area-adu-cost" },
      { label: "Oakland", slug: "oakland-adu-cost" },
    ],
  },
  {
    name: "Inland & Central",
    cities: [
      { label: "Riverside", slug: "riverside-adu-cost" },
      { label: "Sacramento", slug: "sacramento-adu-cost" },
      { label: "Santa Maria", slug: "santa-maria-adu-cost" },
    ],
  },
  {
    name: "San Diego",
    cities: [{ label: "San Diego", slug: "san-diego-adu-cost" }],
  },
];

const buildTypes = [
  { label: "400 sq ft ADU", slug: "400-sq-ft-adu-cost-california" },
  { label: "800 sq ft ADU", slug: "800-sq-ft-adu-cost-california" },
  { label: "JADU", slug: "jadu-cost-california" },
  { label: "Garage conversion", slug: "garage-conversion-adu-cost-california" },
  { label: "Modular vs site-built", slug: "modular-vs-site-built-adu-cost-california" },
  { label: "Prefab brands compared", slug: "prefab-adu-brands-compared-california" },
  { label: "Coastal vs inland", slug: "coastal-vs-inland-adu-cost-california" },
];

const guides = [
  { label: "How to read an ADU bid", slug: "how-to-read-adu-bid" },
  { label: "Soft costs & permits", slug: "adu-soft-costs-permits-california" },
  { label: "All-in cost", slug: "adu-all-in-cost-california" },
  { label: "Rent payback & ROI", slug: "adu-rent-payback-roi-california" },
  { label: "US fee shockers", slug: "us-adu-fee-shockers" },
];

const videos = [
  {
    kind: "Short",
    date: "Oct 10, 2026",
    title: "The 750 sq ft Cliff Ends Jan 1, 2027",
    dek: "SB 1117 limits impact fees to the square footage above 750.",
    url: "https://www.youtube.com/shorts/RK3q3afEbZY",
  },
  {
    kind: "Long-form",
    date: "Oct 9, 2026",
    title: "5 Numbers Missing From Every ADU Quote",
    dek: "The four-bucket method for reading contractor bids.",
    url: "https://youtu.be/PET8o-xDKgo",
  },
];

const seriesItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "California ADU cost series",
  description: homeDescription,
  numberOfItems: sortedPosts.length,
  itemListElement: sortedPosts.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`posts/${post.id}/`, siteUrl).href,
    name: post.data.title,
  })),
};

const formatShortDate = (d: string | Date) =>
  dayjs(d).tz("America/Los_Angeles").format("MMM D, YYYY");
---

<Layout title={homeTitle} description={homeDescription} ogImage={homeOgImage}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(seriesItemList)}
    />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    {/* HERO — headline + city comparison table */}
    <section id="hero" aria-labelledby="hero-heading" class="border-border border-b pt-8 pb-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-sm font-mono uppercase tracking-wide opacity-60">
            CA ADU Costs
          </p>
          <h1 id="hero-heading" class="my-4 text-3xl font-bold sm:my-6 sm:text-4xl">
            California ADU Cost Breakdowns
          </h1>
          <p class="text-xl font-medium sm:text-2xl">
            Where every ADU dollar actually goes.
          </p>
          <p class="mt-4">
            Line-item cost breakdowns for real California builds. Six phases,
            every fee, every city — so you can check a contractor's number
            before you sign.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <LinkButton
              href="/compare/"
              class="bg-accent text-white font-semibold px-5 py-3 rounded"
            >
              Verify a contractor quote &rarr;
            </LinkButton>
            <LinkButton
              href="/downloads/adu-benchmark-ranges-2026-q3.csv"
              class="border border-border px-5 py-3 rounded font-medium"
            >
              Free 2026 Q3 benchmark CSV
            </LinkButton>
          </div>
          {/* Fee lookup — jurisdiction + size, deep-linked into /compare/ */}
          <form
            id="hero-fee-lookup"
            class="mt-4 flex flex-wrap items-end gap-2"
            aria-label="Look up fees for your jurisdiction"
          >
            <label class="block">
              <span class="text-sm font-medium opacity-70">Your jurisdiction</span>
              <select
                id="hero-juris"
                class="border-border bg-background focus:border-accent mt-1 block w-56 rounded border px-2 py-2 text-sm"
              >
                {heroJurisdictions.map(j => (
                  <option value={j.id}>{j.name}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-medium opacity-70">Size</span>
              <span class="mt-1 flex items-center gap-1">
                <input
                  id="hero-sqft"
                  type="number"
                  value="800"
                  min="100"
                  max="2000"
                  step="1"
                  class="border-border bg-background focus:border-accent w-24 rounded border px-2 py-2 text-sm tabular-nums"
                />
                <span class="text-sm opacity-70">sq ft</span>
              </span>
            </label>
            <button
              type="submit"
              class="bg-accent rounded px-4 py-2 font-semibold text-white"
            >
              See my fees &rarr;
            </button>
          </form>
          <p class="mt-3 text-sm opacity-70">
            Browse fees by region:{" "}
            {feeRegions.map((r, idx) => (
              <span>
                {idx > 0 && " · "}
                <a
                  href={`/fees/#${r.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-accent underline decoration-dashed underline-offset-4"
                >
                  {r}
                </a>
              </span>
            ))}{" "}
            ·{" "}
            <a
              href="/fees/"
              class="text-accent underline decoration-dashed underline-offset-4"
            >
              All cities &rarr;
            </a>
          </p>
          <p class="mt-3 text-sm opacity-70">
            {jurisCount} jurisdictions · every figure links to
            its official source · last verified {latestVerified} · no email needed.{" "}
            <LinkButton
              class="underline decoration-dashed underline-offset-4"
              href="/methodology/"
            >
              How we price &rarr;
            </LinkButton>
          </p>
          {
            socials.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  {t.home.socialLinks}:
                </div>
                <Socials />
              </div>
            )
          }
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="mt-4 inline-flex items-center gap-2"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="text-sm">RSS Feed</span>
          </a>
        </div>

        <aside aria-labelledby="spread-heading" class="border border-border rounded-lg overflow-hidden self-start">
          <div class="px-4 py-3 border-b border-border">
            <h2 id="spread-heading" class="text-lg font-semibold">
              Same 800 sq ft ADU. School fees from {fmtUSD(schoolLow)} to {fmtUSD(schoolHigh)}.
            </h2>
            <p class="text-sm opacity-70">
              One fee line, set by your school district — not your contractor.
              A {(schoolHigh / schoolLow).toFixed(1)}&times; spread before construction even starts. Bars start at
              $0; every figure links to the district's official document.
            </p>
          </div>
          <div class="hidden sm:grid sm:grid-cols-[1fr_7rem_6rem] gap-4 px-4 py-2 border-b border-border text-sm font-semibold opacity-60">
            <span>Jurisdiction</span>
            <span class="text-right">Rate</span>
            <span class="text-right">800 sq ft</span>
          </div>
          <div class="divide-y divide-border">
            {feeSpread.map(({ juris, rateLabel, totalLabel, barWidth, source }) => (
              <a
                href={source}
                target="_blank"
                rel="noopener"
                class="grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_7rem_6rem] gap-x-4 gap-y-1 px-4 py-3 hover:bg-black/5 transition-colors"
                title="Open the official source document"
              >
                <span class="font-semibold">{juris}</span>
                <span class="text-right text-sm tabular-nums opacity-70">{rateLabel}</span>
                <span class="col-span-2 sm:col-span-1">
                  <span
                    class="block h-2.5 rounded-sm bg-accent"
                    style={`width: ${barWidth}`}
                    role="img"
                    aria-label={`${juris} school fee ${totalLabel} for 800 sq ft, bar from $0`}
                  />
                </span>
                <span class="text-right tabular-nums font-bold">
                  {totalLabel}
                </span>
              </a>
            ))}
          </div>
          <div class="px-4 py-3 text-sm">
            <span class="opacity-60">Cheapest 5 and priciest 5 of {schoolRows.length} jurisdictions with verified school-fee line items (the Fee Index counts {schoolFees.length} district line items — some jurisdictions have more than one district).</span>{" "}
            <a href="/compare/" class="text-accent font-semibold">
              Look up your jurisdiction &rarr;
            </a>
          </div>
        </aside>
      </div>
    </section>

    {/* TRUST — every number has a source document */}
    <section aria-labelledby="trust-heading" class="border-border border-b pt-12 pb-6">
      <h2 id="trust-heading" class="text-2xl font-semibold">
        Every number on this page has a source document.
      </h2>
      <p class="mt-3 max-w-3xl">
        No estimated fees, no "typical ranges" from a sales brochure. Every fee here traces to an official source — a city fee schedule, a school district resolution, a utility tariff — and the whole dataset is re-verified on a published schedule.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-border rounded-lg border p-4">
          <div class="text-3xl font-bold tabular-nums">{jurisCount}</div>
          <div class="mt-1 text-sm font-semibold">Jurisdictions tracked</div>
          <p class="mt-1 text-sm opacity-70">Cities and counties with verified ADU fee data, growing batch by batch.</p>
        </div>
        <div class="border-border rounded-lg border p-4">
          <div class="text-3xl font-bold tabular-nums">{verifiedCount}</div>
          <div class="mt-1 text-sm font-semibold">Verified fee line items</div>
          <p class="mt-1 text-sm opacity-70">Each fee checked against the document it came from — no fee modeled, no fee guessed. Construction costs are modeled separately and labeled as such on the quote checker.</p>
        </div>
        <div class="border-border rounded-lg border p-4">
          <div class="text-3xl font-bold tabular-nums">Dec 2026</div>
          <div class="mt-1 text-sm font-semibold">Next full re-verification</div>
          <p class="mt-1 text-sm opacity-70">Fees change every fiscal year. We re-check every line on a schedule we publish in advance.</p>
        </div>
        <div class="border-border rounded-lg border p-4">
          <div class="text-3xl font-bold tabular-nums">0</div>
          <div class="mt-1 text-sm font-semibold">Email gates</div>
          <p class="mt-1 text-sm opacity-70">The calculator, the index, and the dataset are open. No signup stands between you and a number.</p>
        </div>
      </div>
      <p class="mt-6 text-sm opacity-70">
        Who runs this site, how to reach us, and how we fix mistakes:{" "}
        <a href="/about/" class="text-accent font-semibold">About &rarr;</a>{" "}
        <a href="/contact/" class="text-accent font-semibold">Contact &rarr;</a>{" "}
        <a href="/corrections/" class="text-accent font-semibold">Corrections policy &rarr;</a>
      </p>
    </section>

    {/* WHAT CHANGED — the fee change log, newest first */}
    <section aria-labelledby="changes-heading" class="border-border border-b pt-12 pb-6">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 id="changes-heading" class="text-2xl font-semibold">
            What changed
          </h2>
          <p class="mt-2 text-sm opacity-70">
            The fee change log — every verification event, newest first.{" "}
            <a href="/changes/" class="text-accent font-semibold">
              Full log &rarr;
            </a>
          </p>
          <ul class="mt-4 space-y-4">
            {changelog.entries.slice(0, 3).map(e => (
              <li class="border-b border-border pb-4">
                <p class="text-sm font-mono tabular-nums opacity-60">{e.date}</p>
                <p class="font-semibold">{e.headline}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="self-start">
          <FeeAlertSignup idPrefix="home-alert" />
        </div>
      </div>
    </section>

    {/* THE 750 SQ FT LINE — the most shareable single fact */}
    <section aria-labelledby="cliff-heading" class="border-border border-b pt-12 pb-6">
      <div class="max-w-3xl">
        <h2 id="cliff-heading" class="text-2xl font-semibold">
          One square foot can cost you $3,812.
        </h2>
        <p class="mt-3 text-lg opacity-80">
          In Hayward, a 750 sq ft ADU pays $0 in park impact fees. At 751 sq
          ft, the city's worksheet rate of $3,812 kicks in — for one square foot.
          State law draws the line at 750; every city decides what sits on
          either side of it. This is the rule through December 31, 2026. From January 1, 2027, SB 1117 limits impact fees to the square footage above 750 for a homeowner's first two ADUs — how Hayward converts its flat $3,812 to that basis is not yet published.
        </p>
        <p class="mt-4">
          <a href="/compare/" class="text-accent font-semibold">
            Find your city's cliff &rarr;
          </a>
        </p>
      </div>
    </section>

    {/* ANATOMY OF A BID — what "verify a quote" actually means */}
    <section aria-labelledby="anatomy-heading" class="border-border border-b pt-12 pb-6">
      <h2 id="anatomy-heading" class="text-2xl font-semibold">
        Contractors quote in lumps. We break it into six.
      </h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { n: "1", label: "Soft costs", desc: "Design, permits, plan check — the only phase with a public, checkable answer." },
          { n: "2", label: "Site work + foundation", desc: "Grading, trenching, the slab everything sits on." },
          { n: "3", label: "Framing + structure", desc: "Walls, roof, the skeleton." },
          { n: "4", label: "Building envelope", desc: "Windows, doors, roofing, waterproofing." },
          { n: "5", label: "Systems + interior", desc: "Electrical, plumbing, HVAC, drywall, finishes." },
          { n: "6", label: "Landscaping & hardscape", desc: "What the site looks like when the crew leaves." },
        ].map(p => (
          <div class="border border-border rounded-lg p-4">
            <p class="font-mono text-sm opacity-60">{p.n}</p>
            <p class="mt-1 font-semibold">{p.label}</p>
            <p class="mt-1 text-sm opacity-70">{p.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm opacity-70">
        Bids hide the most in phase 1.{" "}
        <a href="/posts/how-to-read-adu-bid/" class="text-accent font-semibold">
          Learn to read a bid &rarr;
        </a>{" "}
        <a href="/compare/" class="text-accent font-semibold">
          Map yours &rarr;
        </a>
      </p>
    </section>

    {/* FEE INDEX BAND — the data edition */}
    <section aria-labelledby="fee-index-heading" class="border-border border-b pt-12 pb-6">
      <p class="text-sm font-semibold tracking-wide uppercase opacity-60">
        The California ADU Fee Index — Q3 2026
      </p>
      <h2 id="fee-index-heading" class="mt-2 text-2xl font-semibold">
        The first public index of what governments charge your ADU.
      </h2>
      <p class="mt-3 max-w-3xl">
        {jurisCount} jurisdictions, {verifiedCount} verified line items. The same 800 sq ft ADU owes {fmtUSD(schoolLow)} in school fees in one city and {fmtUSD(schoolHigh)} in another — and impact fees can swing five figures across a single square foot at the 750 line — in {topCliffJuris}, {fmtUSD(topCliff)}.
      </p>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/fee-index/" class="text-accent font-semibold">
          Read the Fee Index &rarr;
        </a>
        <a href="/downloads/adu-fee-index-2026-q3.csv" class="text-accent font-semibold">
          Download the data (CSV, free) &rarr;
        </a>
      </p>
    </section>

    {/* BROWSE INDEX — by city / by build type / money questions */}
    <section id="browse" aria-labelledby="browse-heading" class="border-border border-b pt-12 pb-6">
      <div class="flex items-baseline justify-between">
        <h2 id="browse-heading" class="text-2xl font-semibold">
          Find your breakdown
        </h2>
        <a href="/posts/" class="text-accent font-semibold text-sm sm:text-base">
          All {sortedPosts.length} posts &rarr;
        </a>
      </div>
      <div class="mt-6 grid gap-8 md:grid-cols-3">
        <nav aria-label="Browse by city">
          <h3 class="text-sm font-mono uppercase tracking-wide opacity-60 border-b border-border pb-2">
            By city
          </h3>
          <div class="mt-4 grid gap-6 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
            {regions.map(region => (
              <div>
                <p class="font-semibold">{region.name}</p>
                <ul class="mt-2 space-y-1.5">
                  {region.cities.map(c => (
                    <li>
                      <LinkButton
                        class="hover:text-accent underline decoration-dashed underline-offset-4"
                        href={`/posts/${c.slug}/`}
                      >
                        {c.label}
                      </LinkButton>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </nav>
        <nav aria-label="Browse by build type">
          <h3 class="text-sm font-mono uppercase tracking-wide opacity-60 border-b border-border pb-2">
            By build type
          </h3>
          <ul class="mt-4 space-y-1.5">
            {buildTypes.map(b => (
              <li>
                <LinkButton
                  class="hover:text-accent underline decoration-dashed underline-offset-4"
                  href={`/posts/${b.slug}/`}
                >
                  {b.label}
                </LinkButton>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Browse money questions">
          <h3 class="text-sm font-mono uppercase tracking-wide opacity-60 border-b border-border pb-2">
            Money questions
          </h3>
          <ul class="mt-4 space-y-1.5">
            {guides.map(g => (
              <li>
                <LinkButton
                  class="hover:text-accent underline decoration-dashed underline-offset-4"
                  href={`/posts/${g.slug}/`}
                >
                  {g.label}
                </LinkButton>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    {/* LATEST + VIDEOS */}
    <section aria-label="Latest posts and videos" class="pt-12 pb-6">
      <div class="grid gap-10 lg:grid-cols-[1fr_22rem]">
        <div>
          <h2 class="text-2xl font-semibold">Latest</h2>
          <ul class="mt-2 divide-y divide-border">
            {latestPosts.map(({ data, id }) => (
              <li>
                <a
                  href={`/posts/${id}/`}
                  class="grid grid-cols-[5.5rem_1fr_auto] gap-4 py-4 items-baseline hover:bg-black/5 transition-colors"
                >
                  <span class="text-sm tabular-nums opacity-60">
                    {formatShortDate(data.pubDatetime)}
                  </span>
                  <span>
                    <span class="block font-semibold text-lg leading-snug">
                      {data.title}
                    </span>
                    <span class="mt-1 block text-sm opacity-70 line-clamp-2">
                      {data.description}
                    </span>
                  </span>
                  {data.keyFacts?.totalCost && (
                    <span class="text-right font-mono font-semibold text-accent whitespace-nowrap">
                      {data.keyFacts.totalCost}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-4">
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </div>
        <div>
          <h2 class="text-2xl font-semibold">Videos</h2>
          <div class="mt-4 space-y-4">
            {videos.map(v => (
              <a
                href={v.url}
                target="_blank"
                rel="noopener"
                class="block border border-border rounded-lg p-4 hover:border-accent transition-colors"
              >
                <div class="text-sm opacity-60 mb-1">
                  {v.kind} &middot; {v.date}
                </div>
                <div class="font-semibold text-accent">{v.title}</div>
                <div class="text-sm opacity-70 mt-1">{v.dek}</div>
              </a>
            ))}
          </div>
          <div class="mt-4">
            <a
              href="https://www.youtube.com/@everylineitem-e5l"
              target="_blank"
              rel="noopener"
              class="text-accent font-semibold"
            >
              All videos on YouTube &rarr;
            </a>
          </div>
          <div class="border-border mt-6 rounded-lg border px-4 py-3">
            <p class="font-semibold">2026 ADU benchmark sheet</p>
            <p class="mt-1 text-sm opacity-90">
              Quarterly cost ranges for every build on this site, in one CSV.
              Free download, no email needed.
            </p>
            <p class="mt-2">
              <LinkButton
                class="text-accent font-semibold underline decoration-dashed underline-offset-4"
                href="/downloads/adu-benchmark-ranges-2026-q3.csv"
              >
                Download the benchmark CSV &rarr;
              </LinkButton>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Mobile sticky CTA — mirrors design 1b */}
    <div class="sticky bottom-0 z-10 border-t border-border bg-[var(--color-background,#fff)] py-3 sm:hidden">
      <a
        href="/compare/"
        class="mx-4 flex min-h-[52px] items-center justify-center rounded bg-accent font-semibold text-white"
      >
        Verify a contractor quote &rarr;
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // Hero fee lookup — deep-link into /compare/ with prefilled params.
    const form = document.getElementById("hero-fee-lookup") as HTMLFormElement | null;
    form?.addEventListener("submit", ev => {
      ev.preventDefault();
      const juris = (document.getElementById("hero-juris") as HTMLSelectElement | null)?.value ?? "";
      const sqft = (document.getElementById("hero-sqft") as HTMLInputElement | null)?.value ?? "800";
      const params = new URLSearchParams({ j: juris, sqft });
      window.location.href = `/compare/?${params.toString()}#fee-calculator`;
    });
  });
</script>
