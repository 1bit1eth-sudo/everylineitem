    font-size: 13px;
    color: #1d4ed8;
    font-weight: 600;
    margin: 0 0 12px 0;
    line-height: 1.45;
  }
  .eli-cliff-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 12px;
  }
  .eli-cliff-table th,
  .eli-cliff-table td {
    border-bottom: 1px solid #e2e8f0;
    padding: 8px 6px;
    text-align: left;
  }
  .eli-cliff-table th {
    color: #475569;
    font-weight: 700;
    background: #f8fafc;
  }
  .eli-cliff-row-current {
    background: #eff6ff;
    font-weight: 600;
  }
  .eli-cliff-text-green {
    color: #15803d;
    font-weight: 700;
  }
  .eli-cliff-disclaimer {
    font-size: 11.5px;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }
</style>

<script>
  import { calcJurisdiction, jurisAreas } from "../lib/feeCalc";

  // The fee calculator above this tool embeds the same public fee data
  // (#fee-data) and its jurisdiction selector (#fee-juris). This tool reads
  // both, so its base fee follows the selected city instead of a guess.
  const dataEl = document.getElementById("fee-data");
  const feeData = dataEl ? JSON.parse(dataEl.textContent || "null") : null;
  const jurisSel = document.getElementById("fee-juris") as HTMLSelectElement | null;
  const areaWrap = document.getElementById("fee-area-wrap") as HTMLElement | null;
  const areaSel = document.getElementById("fee-area") as HTMLSelectElement | null;

  const aduInput = document.getElementById("eli-adu-sqft") as HTMLInputElement;
  const primaryInput = document.getElementById("eli-primary-sqft") as HTMLInputElement;
  const baseFeeInput = document.getElementById("eli-base-fee") as HTMLInputElement;

  const aduDisplay = document.getElementById("eli-adu-sqft-display");
  const primaryDisplay = document.getElementById("eli-primary-sqft-display");
  const baseFeeDisplay = document.getElementById("eli-base-fee-display");
  const baseFeeSource = document.getElementById("eli-base-fee-source");

  const statusBanner = document.getElementById("eli-status-banner");
  const finalFeeEl = document.getElementById("eli-final-fee");
  const feeFormulaEl = document.getElementById("eli-fee-formula");
  const sbLineEl = document.getElementById("eli-sb-line");

  const tableCurrentSqft = document.getElementById("eli-table-current-sqft");
  const tableCurrentRule = document.getElementById("eli-table-current-rule");
  const tableCurrentFee = document.getElementById("eli-table-current-fee");
  const tableSbSqft = document.getElementById("eli-table-sb-sqft");
  const tableSbFee = document.getElementById("eli-table-sb-fee");
  const tableFlatSqft = document.getElementById("eli-table-flat-sqft");
  const tableFlatFee = document.getElementById("eli-table-flat-fee");

  const btn750 = document.getElementById("eli-btn-750");
  const btn751 = document.getElementById("eli-btn-751");

  // Single-family scale: the base fee is the selected city's verified
  // impact fees at 1,600 sq ft. At ADU size = primary size the proration
  // reproduces the verified impact total, so the demo stays consistent
  // with the calculator above.
  const BASE_SQFT = 1600;
  const MODELLED_BASE = 28000;
  let verifiedBase = 0;
  let verifiedJurisName = "";
  let userOverrodeBase = false;

  function formatUSD(num: number) {
    return "$" + Math.round(num).toLocaleString("en-US");
  }

  function selectedArea(): string | null {
    return areaWrap && !areaWrap.hidden && areaSel && areaSel.value
      ? areaSel.value
      : null;
  }

  function computeVerifiedBase(): { base: number; name: string } {
    if (!feeData || !jurisSel) return { base: 0, name: "" };
    const jurisId = jurisSel.value;
    const areas = jurisAreas(feeData, jurisId);
    const area = selectedArea();
    const variants: (string | null)[] =
      area != null ? [area] : areas.length > 0 ? areas : [null];
    let best = 0;
    let name = "";
    for (const a of variants) {
      const r = calcJurisdiction(feeData, jurisId, BASE_SQFT, {
        primarySqft: BASE_SQFT,
        area: a,
        verifiedOnly: true,
      });
      name = r.juris.name;
      if (r.impactLow > best) best = r.impactLow;
    }
    return { base: best, name };
  }

  function sourceText(): string {
    const baseFee = parseInt(baseFeeInput.value, 10);
    if (verifiedBase > 0 && !userOverrodeBase) {
      return (
        `Verified \u2014 ${verifiedJurisName} impact fees at 1,600 sq ft: ` +
        `${formatUSD(verifiedBase)}. Move the slider to model a different base.`
      );
    }
    if (userOverrodeBase) {
      return verifiedBase > 0
        ? `Modeled \u2014 your input: ${formatUSD(baseFee)}. ` +
            `${verifiedJurisName}'s verified figure is ${formatUSD(verifiedBase)} at 1,600 sq ft.`
        : `Modeled \u2014 your input: ${formatUSD(baseFee)}. ` +
            `${verifiedJurisName || "This jurisdiction"} has no verified impact fees on file.`;
    }
    return (
      `Modeled example \u2014 ${verifiedJurisName || "This jurisdiction"} has no verified ` +
      `impact fees on file, so this ${formatUSD(MODELLED_BASE)} is an example, not a city figure. ` +
      `Pick a city in the calculator above to use its verified figure.`
    );
  }

  function syncBaseFromJurisdiction() {
    const { base, name } = computeVerifiedBase();
    verifiedBase = base;
    verifiedJurisName = name;
    userOverrodeBase = false;
    baseFeeInput.value = String(base > 0 ? base : MODELLED_BASE);
    updateCalculator();
  }

  function updateCalculator() {
    const aduSqft = parseInt(aduInput.value, 10);
    const primarySqft = parseInt(primaryInput.value, 10);
    const baseFee = parseInt(baseFeeInput.value, 10);

    if (aduDisplay) aduDisplay.textContent = aduSqft.toLocaleString("en-US") + " sq ft";
    if (primaryDisplay) primaryDisplay.textContent = primarySqft.toLocaleString("en-US") + " sq ft";
    if (baseFeeDisplay) baseFeeDisplay.textContent = formatUSD(baseFee);
    if (baseFeeSource) baseFeeSource.textContent = sourceText();

    const ratio = Math.min(aduSqft / primarySqft, 1);
    const proportionalFee = Math.round(baseFee * ratio);
    // Current law: Gov. Code \u00a7 66311.5(c)(1)(A) exempts ADUs of 750 sq ft OR LESS.
    const isExempt = aduSqft <= 750;
    const actualFee = isExempt ? 0 : proportionalFee;

    // SB 1117 (from Jan 1, 2027, up to 2 ADUs): only the area in excess of
    // 750 sq ft is charged, proportionally against the primary home.
    const excessSqft = Math.max(0, aduSqft - 750);
    const sbFee = Math.round(baseFee * Math.min(excessSqft / primarySqft, 1));
    const sbSavings = actualFee - sbFee;

    if (finalFeeEl) finalFeeEl.textContent = formatUSD(actualFee);
    if (tableCurrentSqft) tableCurrentSqft.textContent = aduSqft.toLocaleString("en-US") + " sq ft";
    if (tableSbSqft) tableSbSqft.textContent = aduSqft.toLocaleString("en-US") + " sq ft";
    if (tableSbFee) tableSbFee.textContent = formatUSD(sbFee);
    if (tableFlatSqft) tableFlatSqft.textContent = aduSqft.toLocaleString("en-US") + " sq ft";
    if (tableFlatFee) tableFlatFee.textContent = formatUSD(baseFee);

    if (isExempt) {
      if (statusBanner) {
        statusBanner.className = "eli-cliff-banner eli-cliff-banner-ok";
        statusBanner.innerHTML =
          "<strong>Exempt Zone (750 sq ft or less):</strong> Your ADU qualifies for $0 local development impact fees under California state law, saving you <strong>" +
          formatUSD(proportionalFee) +
          "</strong>.";
      }
      if (feeFormulaEl) feeFormulaEl.textContent = "750 sq ft or less State Exemption Applied";
      if (tableCurrentRule) tableCurrentRule.textContent = "State Exempt (\u2264 750 sq ft)";
      if (tableCurrentFee) tableCurrentFee.textContent = "$0";
      if (sbLineEl) sbLineEl.textContent =
        "From Jan 1, 2027 (SB 1117, up to 2 ADUs): $0 \u2014 no change at this size.";
    } else {
      const diff = aduSqft - 750;
      if (statusBanner) {
        statusBanner.className = "eli-cliff-banner eli-cliff-banner-warn";
        statusBanner.innerHTML =
          "<strong>750 sq ft Cliff Triggered:</strong> Reducing your plan by <strong>" +
          diff +
          " sq ft</strong> (to 750 sq ft) drops this fee from <strong>" +
          formatUSD(actualFee) +
          "</strong> to <strong>$0</strong>.";
      }
      if (feeFormulaEl) feeFormulaEl.textContent =
        "Proportional Ratio: " + (ratio * 100).toFixed(1) + "% of Primary Home";
      if (tableCurrentRule) tableCurrentRule.textContent =
        "Proportional (" + (ratio * 100).toFixed(1) + "% ratio)";
      if (tableCurrentFee) tableCurrentFee.textContent = formatUSD(actualFee);
      if (sbLineEl) sbLineEl.textContent =
        "From Jan 1, 2027 (SB 1117, up to 2 ADUs): " +
        formatUSD(sbFee) +
        " \u2014 saving " +
        formatUSD(sbSavings) +
        " vs current law.";
    }
  }

  aduInput.addEventListener("input", updateCalculator);
  primaryInput.addEventListener("input", updateCalculator);
  baseFeeInput.addEventListener("input", () => {
    userOverrodeBase = true;
    updateCalculator();
  });

  if (btn750) btn750.addEventListener("click", function () {
    aduInput.value = "750";
    updateCalculator();
  });
  if (btn751) btn751.addEventListener("click", function () {
    aduInput.value = "751";
    updateCalculator();
  });

  if (jurisSel) jurisSel.addEventListener("change", syncBaseFromJurisdiction);
  if (areaSel) areaSel.addEventListener("change", syncBaseFromJurisdiction);

  syncBaseFromJurisdiction();
</script>
