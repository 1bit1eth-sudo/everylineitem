---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// `trail` overrides the URL-derived crumbs (used by the tool pages, whose
// hub is /tools/ rather than their own URL parent). Items without `href`
// render as the current-page text.
type Crumb = { href?: string; label: string };
type Props = { trail?: Crumb[] };
const { trail } = Astro.props;

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  tags: t.nav.tags,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

// if breadcrumb is Home > Posts > [page] <etc>
// replace Posts with localized "Posts (page number)"
// Only for the paginated list (/posts/, /posts/2/ ...). A post detail page
// (/posts/<slug>/) keeps Home > Posts > <slug>.
if (
  breadcrumbList[0] === "posts" &&
  (breadcrumbList[1] === undefined || !isNaN(Number(breadcrumbList[1])))
) {
  breadcrumbList.splice(
    0,
    2,
    `${t.nav.posts} (${t.pagination.page.toLowerCase()} ${breadcrumbList[1] || 1})`
  );
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with localized [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${decodeSegment(breadcrumbList[1])} ${
      Number(breadcrumbList[2]) === 1
        ? ""
        : `(${t.pagination.page.toLowerCase()} ${breadcrumbList[2]})`
    }`
  );
}

// BreadcrumbList JSON-LD (rendered after the nav). Computed here in the
// frontmatter rather than in an inline IIFE in the template: eslint-plugin-astro
// could not parse the IIFE ("'}' expected" at EOF), which failed CI lint.
const jsonLdOrigin = "https://everylineitem.com";
const abs = (href: string) =>
  href.startsWith("http")
    ? href
    : `${jsonLdOrigin}${href.startsWith("/") ? href : `/${href}`}`;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Proper names for hyphenated tool/data sections, which the visible
// breadcrumb only capitalizes ("Sb-1117", "Fee-index").
const jsonLdLabels: Record<string, string> = {
  "sb-1117": "SB 1117",
  "fee-index": "Fee Index",
  "property-tax": "Property Tax",
};
let crumbs: { name: string; item: string }[];
if (trail) {
  crumbs = trail.map(c => ({
    name: c.label,
    item: c.href ? abs(c.href) : Astro.url.href,
  }));
} else {
  const segments = currentUrlPath.split("/").slice(1).filter(Boolean);
  crumbs = segments.map((seg, i) => ({
    name: cap(jsonLdLabels[seg] ?? navLabels[seg] ?? decodeSegment(seg)),
    item:
      i + 1 === segments.length
        ? Astro.url.href
        : abs("/" + segments.slice(0, i + 1).join("/") + "/"),
  }));
}
const jsonLdList = [{ name: t.nav.home, item: `${jsonLdOrigin}/` }, ...crumbs];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: jsonLdList.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
        {t.nav.home}
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      trail
        ? trail.map((crumb, index) =>
            index + 1 === trail.length ? (
              <li>
                <span class="capitalize opacity-75" aria-current="page">
                  {crumb.label}
                </span>
              </li>
            ) : (
              <li class="flex items-center gap-x-1">
                <a href={crumb.href} class="capitalize opacity-70">
                  {crumb.label}
                </a>
                <span aria-hidden="true" class="opacity-70">
                  &raquo;
                </span>
              </li>
            )
          )
        : breadcrumbList.map((breadcrumb, index) =>
            index + 1 === breadcrumbList.length ? (
              <li>
                <span
                  class:list={[
                    "capitalize opacity-75",
                    { lowercase: index > 0 },
                  ]}
                  aria-current="page"
                >
                  {/* make the last part lowercase in Home > Tags > some-tag */}
                  {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
                </span>
              </li>
            ) : (
              <li class="flex items-center gap-x-1">
                <a
                  href={getRelativeLocaleUrl(locale, breadcrumb)}
                  class="capitalize opacity-70"
                >
                  {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
                </a>
                <span aria-hidden="true" class="opacity-70">
                  &raquo;
                </span>
              </li>
            )
          )
    }
  </ul>
</nav>

{
  /* BreadcrumbList mirrors the visible trail above, so crawlers and AI
    search get the same page hierarchy readers see. JSON-LD in the body is
    valid; the component is used on every non-home page. Trail-prop pages
    (tool pages) use their explicit trail; the rest derive it from the URL,
    with cumulative paths for intermediate items and the current page URL
    for the last item. */
}
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbSchema)}
/>
