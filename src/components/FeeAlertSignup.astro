---
/**
 * Fee-change alert signup. Posts to Buttondown's embed endpoint with two tags:
 * "fee-alerts" (all subscribers) and "fee-alert-<JURIS-ID>" (per-jurisdiction).
 * Alerts are sent by hand when researchers re-verify a jurisdiction — no automation yet.
 */
import feesData from "@/data/fees.json";

interface Props {
  idPrefix?: string;
  class?: string;
  heading?: string;
  subtext?: string;
  buttonLabel?: string;
  defaultJuris?: string;
}

const {
  idPrefix = "fee-alert",
  class: className,
  heading = "Get an email when your city's fees change",
  subtext = "We re-verify every jurisdiction on a rolling basis. When your city's numbers move, you'll get the diff — no newsletter, no sales, unsubscribe anytime.",
  buttonLabel = "Notify me",
  defaultJuris = "",
} = Astro.props;

const jurisdictions = [...feesData.jurisdictions]
  .filter(j => j.juris_id !== "LA-BASE")
  .sort((a, b) => a.name.localeCompare(b.name, "en-US"));

const emailId = `${idPrefix}-email`;
const jurisId = `${idPrefix}-juris`;
const tagId = `${idPrefix}-juris-tag`;
const headingId = `${idPrefix}-heading`;
---

<section
  class:list={["border-border bg-background rounded-lg border p-4 sm:p-5", className]}
  aria-labelledby={headingId}
  data-pagefind-ignore
>
  <h2 id={headingId} class="mt-0 text-lg font-semibold">{heading}</h2>
  <p class="text-foreground/80 mt-1 mb-3 text-sm">{subtext}</p>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/everylineitem"
    method="post"
    class="embeddable-buttondown-form flex flex-col gap-2"
  >
    <label for={jurisId} class="sr-only">Jurisdiction</label>
    <input
      type="search"
      data-juris-filter={jurisId}
      placeholder="Type to filter jurisdictions…"
      aria-label="Filter jurisdictions"
      class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none"
    />
    <select
      id={jurisId}
      class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none"
    >
      <option value="ALL" selected={defaultJuris === ""}>All jurisdictions</option>
      {jurisdictions.map(j => (
        <option value={j.juris_id} selected={j.juris_id === defaultJuris}>
          {j.name}
        </option>
      ))}
    </select>
    <div class="flex flex-col gap-2 sm:flex-row">
      <label for={emailId} class="sr-only">Email address</label>
      <input
        id={emailId}
        type="email"
        name="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
        class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none sm:flex-1"
      />
      <input type="hidden" name="embed" value="1" />
      <input type="hidden" name="tag" value="fee-alerts" />
      <input type="hidden" name="tag" id={tagId} value="fee-alert-ALL" />
      <button
        type="submit"
        class="bg-accent text-accent-foreground focus-outline inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-opacity hover:opacity-90"
      >
        {buttonLabel}
      </button>
    </div>
  </form>
</section>

<script define:vars={{ jurisId, tagId }}>
  const sel = document.getElementById(jurisId);
  const tag = document.getElementById(tagId);
  sel?.addEventListener("change", () => {
    if (sel instanceof HTMLSelectElement && tag instanceof HTMLInputElement) {
      tag.value = "fee-alert-" + sel.value;
    }
  });
</script>

<script is:inline src="/scripts/juris-filter.js"></script>
