---
import rawFeesJson from "../data/fees.json";
import { getCollection } from "astro:content";
import { postFilter } from "../utils/postFilter";
import {
  resultsHTML,
  jurisAreas,
  DEFAULT_PRIMARY_SQFT,
  type FeeData,
} from "../lib/feeCalc";

// Strip internal memos from the client bundle — internal_notes never ships.
type RawFeeItem = Record<string, unknown>;
const rawData = rawFeesJson as unknown as { fee_items: RawFeeItem[] } & Record<string, unknown>;
// Only link to posts that are actually published (scheduled posts 404 until their date).
const publishedPostIds = new Set((await getCollection("posts")).filter(postFilter).map(p => p.id));
const feesJson = {
  ...rawData,
  jurisdictions: (rawData.jurisdictions as RawFeeItem[]).map(j =>
    j.post_slug && !publishedPostIds.has(j.post_slug as string) ? { ...j, post_slug: "" } : j
  ),
  fee_items: rawData.fee_items.map(({ internal_notes: _internal, ...publicItem }) => publicItem),
} as unknown as FeeData;

const data = feesJson as unknown as FeeData;

const DEFAULT_JURIS = "SAN-JOSE";
const DEFAULT_SQFT = 800;
const DEFAULT_PRIMARY = DEFAULT_PRIMARY_SQFT;
const MIN_PRIMARY = 500;
const MAX_PRIMARY = 10000;
const MIN_SQFT = 200;
const MAX_SQFT = 1200;
const CLIFF_SQFT = data.rules.impact_exempt_max_sqft; // 750

// Tick position for the 750 sq ft cliff mark on the slider (percent).
const cliffPct = ((CLIFF_SQFT - MIN_SQFT) / (MAX_SQFT - MIN_SQFT)) * 100;

const regionLabel = (r: string) =>
  r === "SoCal" ? "Southern California" : r;

const regions = [...new Set(data.jurisdictions.map(j => j.region))];

const selectClass =
  "border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none";
---

<section
  id="fee-calculator"
  class="border-border bg-background mb-8 rounded-lg border p-4 sm:p-6"
  aria-labelledby="fee-calculator-title"
>
  <div>
    <h2 id="fee-calculator-title" class="text-xl font-semibold">
      ADU fee calculator
    </h2>
    <p class="text-foreground/80 mt-2 text-sm">
      Pick a jurisdiction and a size. Every line below comes from that city's
      published fee schedule — with the source linked, and the 750&nbsp;sq&nbsp;ft
      cliff drawn where state law draws it.
    </p>
    <div
      class="mt-3 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm"
      role="note"
    >
      <strong class="font-semibold">Coming Jan 1, 2027 — SB 1117:</strong>
      for your first two ADUs, impact fees will apply only to square footage
      <em>above</em> 750&nbsp;sq&nbsp;ft, not the full unit. Figures below reflect
      current 2026 rules.
    </div>
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <label class="flex flex-col gap-2 text-sm font-medium">
      <span>Jurisdiction</span>
      <input
        type="search"
        data-juris-filter="fee-juris"
        placeholder="Type to filter jurisdictions…"
        aria-label="Filter jurisdictions"
        class={selectClass}
      />
      <select id="fee-juris" class={selectClass} data-combobox>
        {
          regions.map(region => (
            <optgroup label={regionLabel(region)}>
              {data.jurisdictions
                .filter(j => j.region === region && j.status !== "illustrative")
                .sort((a, b) => a.name.localeCompare(b.name, "en-US"))
                .map(j => (
                  <option
                    value={j.juris_id}
                    selected={j.juris_id === DEFAULT_JURIS}
                  >
                    {j.name}
                  </option>
                ))}
            </optgroup>
          ))
        }
      </select>
    </label>

    <div class="flex flex-col gap-2 text-sm font-medium">
      <span>
        ADU size ·{" "}
        <span id="fee-sqft-val" class="tabular-nums"
          >{DEFAULT_SQFT.toLocaleString("en-US")} sq ft</span
        >
      </span>
      <div class="relative pt-1 pb-5">
        <input
          id="fee-sqft"
          type="range"
          min={MIN_SQFT}
          max={MAX_SQFT}
          step="1"
          value={DEFAULT_SQFT}
          aria-label="ADU size in square feet"
          class="accent-accent w-full"
        />
        <div
          class="pointer-events-none absolute top-1 bottom-0"
          style={`left: ${cliffPct}%`}
          aria-hidden="true"
        >
          <div
            class="bg-amber-500/70 mx-auto h-full w-px"
          ></div>
          <div
            class="text-amber-700 dark:text-amber-400 absolute top-full -translate-x-1/2 text-[0.65rem] font-semibold whitespace-nowrap"
          >
            750 cliff
          </div>
        </div>
        <div
          class="text-foreground/60 flex justify-between text-xs tabular-nums"
          aria-hidden="true"
        >
          <span>{MIN_SQFT}</span>
          <span>{MAX_SQFT}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <label class="flex flex-col gap-2 text-sm font-medium">
      <span>Primary dwelling size</span>
      <span class="flex items-center gap-1">
        <input
          id="fee-primary"
          type="number"
          value={DEFAULT_PRIMARY}
          min={MIN_PRIMARY}
          max={MAX_PRIMARY}
          step="50"
          aria-label="Primary dwelling size in square feet"
          class={selectClass}
        />
        <span class="text-sm font-normal opacity-70">sq ft</span>
      </span>
      <span class="text-xs font-normal opacity-70">
        Only used to prorate dwelling-base impact fees (ADU ÷ primary). The
        1,600 sq ft default is an assumption, not a verified figure — enter
        your home's actual size.
      </span>
    </label>

    <label id="fee-area-wrap" class="flex flex-col gap-2 text-sm font-medium" hidden>
      <span>Area schedule</span>
      <select id="fee-area" class={selectClass}></select>
      <span class="text-xs font-normal opacity-70">
        This jurisdiction has mutually exclusive area schedules — a parcel
        pays one, not both.
      </span>
    </label>
  </div>

  <div class="mt-4 flex justify-end">
    <button
      id="fee-copy-link"
      type="button"
      class="border-border hover:border-accent focus-outline inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-medium"
    >
      Copy link
    </button>
  </div>

  <div id="fee-results" class="mt-4" aria-live="polite">
    <Fragment set:html={resultsHTML(data, DEFAULT_JURIS, DEFAULT_SQFT)} />
  </div>

  <div
    id="fee-report-box"
    class="border-border mt-6 rounded-lg border p-4 sm:p-5"
  >
    <h3 class="text-base font-semibold">Email me this report (PDF)</h3>
    <p class="text-foreground/80 mt-1 text-sm">
      Get this exact fee breakdown — your chosen jurisdiction and size — as
      a one-page PDF. No spam. No phone call. Unsubscribe anytime.
    </p>
    <form
      id="fee-report-form"
      action="https://buttondown.com/api/emails/embed-subscribe/everylineitem"
      method="post"
      target="fee-report-iframe"
      class="mt-3 flex flex-col gap-2 sm:flex-row"
    >
      <label for="fee-report-email" class="sr-only">Email address</label>
      <input
        id="fee-report-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
        class="border-border bg-background focus:border-accent focus:ring-accent w-full rounded-md border px-3 py-2 text-base font-normal focus:ring-1 focus:outline-none sm:flex-1"
      />
      <input type="hidden" name="embed" value="1" />
      <input type="hidden" name="tag" value="compare-pdf-report" />
      <button
        type="submit"
        id="fee-report-submit"
        class="bg-accent text-accent-foreground focus-outline inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-opacity hover:opacity-90"
      >
        Send PDF
      </button>
    </form>
    <p
      id="fee-report-status"
      class="mt-2 text-sm"
      aria-live="polite"
      hidden
    ></p>
    <iframe
      name="fee-report-iframe"
      title="Email signup"
      class="hidden"
      aria-hidden="true"
      tabindex="-1"
    ></iframe>
  </div>
</section>

<script
  id="fee-data"
  type="application/json"
  is:inline
  set:html={JSON.stringify(data)}
/>

<script>
  import { resultsHTML } from "../lib/feeCalc";
  import { buildFeeReport, downloadFeeReportPDF } from "../lib/feeReport";

  const dataEl = document.getElementById("fee-data");
  const data = JSON.parse(dataEl ? dataEl.textContent || "{}" : "{}");
  const jurisSel = document.getElementById("fee-juris") as HTMLSelectElement | null;
  const sqftInput = document.getElementById("fee-sqft") as HTMLInputElement | null;
  const sqftVal = document.getElementById("fee-sqft-val");
  const primaryInput = document.getElementById("fee-primary") as HTMLInputElement | null;
  const areaWrap = document.getElementById("fee-area-wrap") as HTMLElement | null;
  const areaSel = document.getElementById("fee-area") as HTMLSelectElement | null;
  const results = document.getElementById("fee-results");

  function jurisAreas(jurisId: string): string[] {
    const areas = new Set<string>();
    for (const i of data.fee_items || []) {
      if (i.juris_id === jurisId && i.area != null && i.area !== "") {
        areas.add(i.area);
      }
    }
    return [...areas].sort((a, b) => a.localeCompare(b, "en-US"));
  }

  function syncAreaSelect() {
    if (!jurisSel || !areaWrap || !areaSel) return;
    const areas = jurisAreas(jurisSel.value);
    if (areas.length === 0) {
      areaWrap.hidden = true;
      areaSel.innerHTML = "";
      return;
    }
    areaWrap.hidden = false;
    const prev = areaSel.value;
    areaSel.innerHTML = areas
      .map(a => `<option value="${a}">${a}</option>`)
      .join("");
    if (prev && areas.includes(prev)) areaSel.value = prev;
  }

  function calcOpts() {
    const primary = primaryInput ? Math.round(Number(primaryInput.value)) : NaN;
    return {
      primarySqft: Number.isFinite(primary) && primary > 0 ? primary : 1600,
      area: areaSel && areaWrap && !areaWrap.hidden && areaSel.value ? areaSel.value : null,
    };
  }

  function update() {
    if (!jurisSel || !sqftInput || !results) return;
    const sqft = Number(sqftInput.value);
    if (sqftVal) {
      sqftVal.textContent = `${sqft.toLocaleString("en-US")} sq ft`;
    }
    results.innerHTML = resultsHTML(data, jurisSel.value, sqft, calcOpts());
    syncShareUrl(); // [share-url] keep the URL copy-paste shareable
  }

  if (jurisSel && sqftInput && results) {
    jurisSel.addEventListener("change", () => {
      syncAreaSelect();
      update();
    });
    sqftInput.addEventListener("input", update);
    if (primaryInput) primaryInput.addEventListener("input", update);
    if (areaSel) areaSel.addEventListener("change", update);
  }

  /* ============================================================
   * [share-url] Shareable calculator URLs — isolated block.
   * Reads ?jurisdiction= (alias: ?j=, kept for the homepage hero fee
   * lookup) and ?sqft= on load, then keeps the URL in sync via
   * history.replaceState as the user changes the controls, so the
   * current view is always copy-paste shareable. Client-side only;
   * no SSR changes needed. Kept in one place so the upcoming
   * quote-check v2 change to /compare/ can build on it cleanly.
   * ============================================================ */
  const SHARE_JURIS_KEYS = ["jurisdiction", "j"];

  function readShareParams() {
    // Prefill the controls from the URL before the first render.
    // Unknown jurisdiction -> ignore (default state). Non-numeric sqft
    // -> ignore. Numeric sqft is clamped to the slider's own min/max.
    try {
      const params = new URLSearchParams(window.location.search);
      let pj = null;
      for (const key of SHARE_JURIS_KEYS) {
        const v = params.get(key);
        if (v) {
          pj = v;
          break;
        }
      }
      if (pj && jurisSel) {
        const needle = pj.trim().toUpperCase();
        const match = [...jurisSel.options].find(
          o => o.value.toUpperCase() === needle
        );
        if (match) jurisSel.value = match.value;
      }
      syncAreaSelect();
      const parea = params.get("area");
      if (parea && areaSel && areaWrap && !areaWrap.hidden) {
        const match = [...areaSel.options].find(o => o.value === parea);
        if (match) areaSel.value = match.value;
      }
      const pprimary = params.get("primary");
      if (pprimary !== null && pprimary !== "" && primaryInput) {
        const n = Math.round(Number(pprimary));
        if (Number.isFinite(n)) {
          const min = Number(primaryInput.min);
          const max = Number(primaryInput.max);
          const lo = Number.isFinite(min) ? min : 0;
          const hi = Number.isFinite(max) ? max : Infinity;
          primaryInput.value = String(Math.min(hi, Math.max(lo, n)));
        }
      }
      const psqft = params.get("sqft");
      if (psqft !== null && psqft !== "" && sqftInput) {
        const n = Math.round(Number(psqft));
        if (Number.isFinite(n)) {
          const min = Number(sqftInput.min);
          const max = Number(sqftInput.max);
          const lo = Number.isFinite(min) ? min : 0;
          const hi = Number.isFinite(max) ? max : Infinity;
          sqftInput.value = String(Math.min(hi, Math.max(lo, n)));
        }
      }
    } catch {
      /* ignore malformed query strings */
    }
  }

  function syncShareUrl() {
    // Reflect the current calculator state in the URL without reloading.
    // replaceState never fires events, so this cannot loop with update().
    if (!jurisSel || !sqftInput) return;
    try {
      const url = new URL(window.location.href);
      url.searchParams.set("jurisdiction", jurisSel.value);
      url.searchParams.set("sqft", sqftInput.value);
      if (primaryInput) url.searchParams.set("primary", primaryInput.value);
      if (areaSel && areaWrap && !areaWrap.hidden && areaSel.value) {
        url.searchParams.set("area", areaSel.value);
      } else {
        url.searchParams.delete("area");
      }
      window.history.replaceState(null, "", url);
    } catch {
      /* non-fatal: the visible controls still work without URL sync */
    }
  }

  // "Copy link" button — copies the current (always in-sync) URL and
  // shows a brief confirmation. Falls back for browsers without the
  // async clipboard API.
  const copyBtn = document.getElementById("fee-copy-link");
  if (copyBtn) {
    const copyLabel = copyBtn.textContent;
    copyBtn.addEventListener("click", async () => {
      let ok = true;
      try {
        const href = window.location.href;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(href);
        } else {
          const ta = document.createElement("textarea");
          ta.value = href;
          ta.setAttribute("readonly", "");
          ta.style.position = "absolute";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          ok = document.execCommand("copy");
          ta.remove();
        }
      } catch {
        ok = false;
      }
      copyBtn.textContent = ok ? "Copied" : "Copy failed";
      window.setTimeout(() => {
        copyBtn.textContent = copyLabel;
      }, 2000);
    });
  }

  readShareParams();
  update();

  // "Email me this report (PDF)" — generate the PDF client-side and download
  // it immediately, while the form POSTs the email to Buttondown in a hidden
  // iframe (same endpoint as EmailSignup.astro). jsPDF is dynamically
  // imported so it only loads when the user actually requests the report.
  const reportForm = document.getElementById(
    "fee-report-form"
  ) as HTMLFormElement | null;
  const reportEmail = document.getElementById(
    "fee-report-email"
  ) as HTMLInputElement | null;
  const reportStatus = document.getElementById("fee-report-status");
  const reportSubmit = document.getElementById(
    "fee-report-submit"
  ) as HTMLButtonElement | null;

  function setStatus(msg: string, ok: boolean) {
    if (!reportStatus) return;
    reportStatus.hidden = false;
    reportStatus.textContent = msg;
    reportStatus.className = ok
      ? "mt-2 text-sm text-green-700 dark:text-green-400"
      : "mt-2 text-sm text-red-700 dark:text-red-400";
  }

  if (reportForm && jurisSel && sqftInput) {
    reportForm.addEventListener("submit", async () => {
      // Native email validation runs before this handler; if we are here
      // the address is syntactically valid. Do NOT preventDefault — the
      // form must still POST to Buttondown via the hidden iframe target.
      if (reportSubmit) {
        reportSubmit.disabled = true;
        reportSubmit.textContent = "Preparing PDF…";
      }
      try {
        const { jsPDF } = await import("jspdf");
        const report = buildFeeReport(
          data,
          jurisSel.value,
          Number(sqftInput.value),
          calcOpts()
        );
        downloadFeeReportPDF(jsPDF, report);
        setStatus(
          "Your PDF is downloading — and you're on the list. Occasional fee-schedule updates only.",
          true
        );
      } catch (err) {
        console.error("[fee-report]", err);
        setStatus(
          "Couldn't generate the PDF in this browser — but your email was still sent. Sorry about that.",
          false
        );
      } finally {
        if (reportSubmit) {
          reportSubmit.disabled = false;
          reportSubmit.textContent = "Send PDF";
        }
        if (reportEmail) reportEmail.value = "";
      }
    });
  }
</script>

<script is:inline src="/scripts/juris-filter.js"></script>
