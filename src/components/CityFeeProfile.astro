---
/**
 * City-specific fee profile for /fees/[slug]: comparison with neighbours,
 * where the money goes (inline SVG, no JS), a worked example across sizes,
 * and the source documents behind the page. All figures come from
 * cityProfile() — verified rows of fees.json, computed at build time.
 */
import {
  type CityProfile,
  compareSentence,
  largestSentence,
  usd,
  pct,
  PROFILE_SQFT,
} from "@/lib/cityProfile";
import { formatVerified } from "@/utils/formatVerified";

interface Props {
  profile: CityProfile;
}
const { profile: p } = Astro.props;
const n = p.juris.name;
const scope =
  p.peerScope === "county" ? `${p.juris.county} County` : `${p.juris.region}`;

// Chart geometry
const W = 640;
const rowH = 30;
const labelW = 190;
const valW = 120;
const barMax = W - labelW - valW - 10;
const maxCat = Math.max(1, ...p.categories.map(c => c.amount));
const H = 8 + p.categories.length * rowH + 4;

const ex = (s: number) => p.examples.find(e => e.sqft === s)!;
const jump = ex(751).total - ex(750).total;
const impactJump = ex(751).impact - ex(750).impact;
const anyNonZero = p.examples.some(e => e.total > 0);
const grow = ex(1200).total - ex(1000).total;
const methodBits = [
  p.perSqftCount > 0 && `${p.perSqftCount} charged per square foot`,
  p.flatCount > 0 &&
    `${p.flatCount} as ${p.flatCount === 1 ? "a flat amount" : "flat amounts"}`,
  p.valuationCount > 0 &&
    `${p.valuationCount} as a share of construction valuation or of another fee`,
].filter(Boolean) as string[];
const largest = largestSentence(p);
---

<section class="mt-10" aria-labelledby="profile-heading">
  <h2 id="profile-heading" class="text-2xl font-semibold">
    How {n} compares
  </h2>
  <p class="mt-3 max-w-3xl opacity-90">{compareSentence(p)}</p>
  {
    p.peers.length > 1 && (
      <div class="mt-4 overflow-x-auto">
        <table class="w-full max-w-2xl border-collapse text-sm">
          <caption class="mb-2 text-left text-sm opacity-70">
            Verified government fees on an {PROFILE_SQFT} sq ft ADU, {scope}
            {p.peerScope === "region" ? " region" : ""} —{" "}
            {p.peerCount > p.peers.length
              ? `top ${p.peers.length - 1} of ${p.peerCount} plus this page`
              : `all ${p.peerCount} we track`}{" "}
            — same math as the{" "}
            <a
              class="text-accent underline decoration-dashed underline-offset-4"
              href="/fee-index/"
            >
              Fee Index
            </a>
            .
          </caption>
          <thead>
            <tr class="border-border border-b text-left">
              <th class="py-2 pe-3 font-semibold">Jurisdiction</th>
              <th class="py-2 pe-3 text-right font-semibold">Verified lines</th>
              <th class="py-2 text-right font-semibold">
                Total, {PROFILE_SQFT} sq ft
              </th>
            </tr>
          </thead>
          <tbody>
            {p.peers.map(r => (
              <tr class={`border-border border-b ${r.self ? "font-bold" : ""}`}>
                <td class="py-2 pe-3">
                  {r.self ? (
                    <>{r.name} (this page)</>
                  ) : (
                    <a
                      class="text-accent underline decoration-dashed underline-offset-4"
                      href={`/fees/${r.jurisId.toLowerCase()}/`}
                    >
                      {r.name}
                    </a>
                  )}
                </td>
                <td class="py-2 pe-3 text-right tabular-nums">{r.count}</td>
                <td class="py-2 text-right tabular-nums">{usd(r.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-2 text-sm opacity-70">
          Totals are confirmed floors: a jurisdiction with fewer verified lines
          can look cheaper than it is.
        </p>
      </div>
    )
  }

  {
    p.categories.length > 0 && (
      <>
        <h3 class="mt-8 text-xl font-semibold">Where the money goes in {n}</h3>
        <p class="mt-2 max-w-3xl opacity-90">
          {p.categories[0].label}{" "}
          {p.categories[0].label.endsWith("s") ? "are" : "is"} the biggest share
          of {n}'s verified fees for an {PROFILE_SQFT} sq ft ADU (
          {pct(p.categories[0].share)}).
          {largest && <> {largest}</>}
          {methodBits.length > 0 && (
            <>
              {" "}
              Of the {p.perSqftCount + p.flatCount + p.valuationCount} verified
              lines on file{p.area ? ` in the ${p.area} schedule` : ""},{" "}
              {methodBits.join(", ")}.
            </>
          )}
          {p.proratedCount > 0 && (
            <>
              {" "}
              {p.proratedCount}{" "}
              {p.proratedCount === 1
                ? "is a per-dwelling fee"
                : "are per-dwelling fees"}{" "}
              that an ADU pays in proportion (ADU ÷ primary home, assumed 1,600
              sq ft here).
            </>
          )}
        </p>
        <figure class="my-4">
          <svg
            viewBox={`0 0 ${W} ${H}`}
            width="100%"
            role="img"
            aria-labelledby="cat-title cat-desc"
            class="h-auto max-w-2xl"
          >
            <title id="cat-title">{`${n} verified ADU fees by category, ${PROFILE_SQFT} sq ft`}</title>
            <desc id="cat-desc">
              {p.categories
                .map(c => `${c.label}: ${usd(c.amount)} (${pct(c.share)})`)
                .join("; ")}
            </desc>
            {p.categories.map((c, i) => {
              const y = 8 + i * rowH;
              const w = Math.max(2, (c.amount / maxCat) * barMax);
              return (
                <g>
                  <text
                    x={labelW - 8}
                    y={y + 19}
                    text-anchor="end"
                    class="cp-label"
                  >
                    {c.label}
                  </text>
                  <rect
                    x={labelW}
                    y={y + 6}
                    width={w}
                    height={18}
                    rx="3"
                    class="cp-bar"
                  />
                  <text
                    x={labelW + w + 6}
                    y={y + 19}
                    class="cp-value"
                  >{`${usd(c.amount)} · ${pct(c.share)}`}</text>
                </g>
              );
            })}
          </svg>
          <figcaption class="mt-1 text-sm opacity-70">
            Verified lines only{p.area ? `, ${p.area} schedule` : ""}; exempt
            lines and rates without a dollar basis are left out. Built from the
            table above.
          </figcaption>
        </figure>
      </>
    )
  }

  {
    anyNonZero && (
      <>
        <h3 class="mt-8 text-xl font-semibold">
          Worked example: the same ADU at five sizes
        </h3>
        <p class="mt-2 max-w-3xl opacity-90">
          {impactJump > 0
            ? `In ${n}, going from 750 to 751 sq ft adds ${usd(impactJump)} in verified impact fees — the state-law line, one square foot wide. `
            : jump > 0
              ? `In ${n}, no verified impact fee starts above 750 sq ft, so one extra square foot moves the total only by ${usd(jump)} from size-based lines. `
              : `In ${n}, the verified fees we have do not jump between 750 and 751 sq ft, because no verified impact fee applies above the line. `}
          {grow > 0
            ? `Growing from 1,000 to 1,200 sq ft adds another ${usd(grow)}, because ${p.perSqftCount > 0 ? "per-square-foot lines scale with size" : "proportional fees scale with size"}.`
            : `Growing from 1,000 to 1,200 sq ft does not change the verified total, because the verified lines here are flat.`}
        </p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full max-w-xl border-collapse text-sm">
            <thead>
              <tr class="border-border border-b text-left">
                <th class="py-2 pe-3 font-semibold">ADU size</th>
                <th class="py-2 pe-3 text-right font-semibold">Impact fees</th>
                <th class="py-2 text-right font-semibold">All verified fees</th>
              </tr>
            </thead>
            <tbody>
              {p.examples.map(e => (
                <tr class="border-border border-b">
                  <td class="py-2 pe-3 tabular-nums">
                    {e.sqft.toLocaleString("en-US")} sq ft
                  </td>
                  <td class="py-2 pe-3 text-right tabular-nums">
                    {usd(e.impact)}
                  </td>
                  <td class="py-2 text-right font-semibold tabular-nums">
                    {usd(e.total)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-sm opacity-70">
          2026 rules{p.area ? `, ${p.area} schedule` : ""}. School fees are
          exempt below 500 sq ft; impact fees are $0 at 750 sq ft or less (Gov.
          Code §66311.5). For any other size, use the{" "}
          <a
            class="text-accent underline decoration-dashed underline-offset-4"
            href={`/compare/?j=${p.juris.juris_id}&sqft=${PROFILE_SQFT}#fee-calculator`}
          >
            calculator
          </a>
          .
        </p>
      </>
    )
  }

  {
    p.sources.length > 0 && (
      <>
        <h3 class="mt-8 text-xl font-semibold">
          Documents behind {n}'s figures
        </h3>
        <ul class="mt-2 list-disc space-y-1 ps-5 text-sm">
          {p.sources.map(s => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="text-accent underline decoration-dashed underline-offset-4"
              >
                {s.note ?? new URL(s.url).hostname}
              </a>
              <span class="opacity-70">
                {" "}
                — {s.lines} verified line{s.lines === 1 ? "" : "s"}
                {s.lastVerified && (
                  <>, checked {formatVerified(s.lastVerified)}</>
                )}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  .cp-label {
    font-size: 13px;
    fill: var(--foreground);
  }
  .cp-value {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    fill: var(--foreground);
  }
  .cp-bar {
    fill: var(--accent);
  }
</style>
